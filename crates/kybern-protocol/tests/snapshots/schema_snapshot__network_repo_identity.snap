---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(ProjectRepoIdentity)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectRepoIdentity",
  "description": "What `projects.repo_identity` stores for a project.",
  "type": "object",
  "properties": {
    "repo": {
      "anyOf": [
        {
          "$ref": "#/$defs/RepoIdentity"
        },
        {
          "type": "null"
        }
      ]
    },
    "repos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RepoIdentity"
      }
    }
  },
  "$defs": {
    "RepoIdentity": {
      "description": "What makes two checkouts the same logical project on different machines.",
      "type": "object",
      "properties": {
        "root_commit": {
          "description": "The smallest hash in `git rev-list --max-parents=0 HEAD`.",
          "type": [
            "string",
            "null"
          ]
        },
        "remote": {
          "description": "The `origin` URL normalized to `host/owner/repo`: lowercase, no scheme, user or `.git`.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
