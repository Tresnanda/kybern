---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(SkillConflict)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillConflict",
  "description": "Data of the `CONFLICT` error a target answers when a home holds a version the user did not agree to replace.",
  "type": "object",
  "properties": {
    "home": {
      "$ref": "#/$defs/SkillHome"
    },
    "path": {
      "type": "string"
    },
    "hash": {
      "description": "Absent for something that is not a copyable skill (a file, or a link elsewhere).",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "home",
    "path"
  ],
  "$defs": {
    "SkillHome": {
      "description": "A harness's user skill folder.",
      "oneOf": [
        {
          "description": "`~/.agents/skills`: read by Codex, Cursor, OpenCode and omp.",
          "type": "string",
          "const": "agents"
        },
        {
          "description": "`$CLAUDE_CONFIG_DIR/skills` or `~/.claude/skills`: Claude Code, also read by Cursor and OpenCode.",
          "type": "string",
          "const": "claude"
        },
        {
          "description": "`$CODEX_HOME/skills` or `~/.codex/skills`: Codex, also read by Cursor.",
          "type": "string",
          "const": "codex"
        },
        {
          "description": "`~/.cursor/skills`.",
          "type": "string",
          "const": "cursor"
        },
        {
          "description": "`$XDG_CONFIG_HOME/opencode/skills` or `~/.config/opencode/skills`.",
          "type": "string",
          "const": "opencode"
        },
        {
          "description": "`$PI_CODING_AGENT_DIR/skills` or `~/.pi/agent/skills`: pi, also read by omp.",
          "type": "string",
          "const": "pi"
        },
        {
          "description": "`~/.omp/agent/skills` (or the active omp profile's).",
          "type": "string",
          "const": "omp"
        }
      ]
    }
  }
}
