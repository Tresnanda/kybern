---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(Origin)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Origin",
  "description": "Where work that another machine started came from. Only a daemon sets it, and it never changes.",
  "type": "object",
  "properties": {
    "machine_id": {
      "type": "string"
    },
    "machine_name": {
      "type": "string"
    },
    "thread_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "$ref": "#/$defs/OriginKind"
    },
    "permission_cap": {
      "$ref": "#/$defs/PermissionMode"
    },
    "hops": {
      "description": "Machine ids, oldest first; at most one in v1.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "machine_id",
    "machine_name",
    "operation_id",
    "kind",
    "permission_cap"
  ],
  "$defs": {
    "OriginKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "composer"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "delegation"
            }
          },
          "required": [
            "kind",
            "task_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tool_call"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "fork"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "move"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "PermissionMode": {
      "description": "The four permission modes.",
      "oneOf": [
        {
          "description": "Every tool call that mutates or executes asks for approval.",
          "type": "string",
          "const": "supervised"
        },
        {
          "description": "File edits proceed; shell and network still ask.",
          "type": "string",
          "const": "accept-edits"
        },
        {
          "description": "The provider decides with its own safety heuristics; asks only when unsure.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Nothing asks. Sandboxing is the provider's problem.",
          "type": "string",
          "const": "full-access"
        }
      ]
    }
  }
}
