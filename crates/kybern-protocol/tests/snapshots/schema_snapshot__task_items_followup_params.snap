---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(TaskItemsFollowupParams)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskItemsFollowupParams",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "text": {
      "description": "Plain text. Exactly one of `text` or `message` is required.",
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "description": "The full follow-up (text, mentions, skills, files, thread references,\nattachments), sent or queued as is. When no run can receive it, a message\nof text and references is saved as readable text for the next run; one\nwith attachments is refused.",
      "anyOf": [
        {
          "$ref": "#/$defs/UserMessage"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id"
  ],
  "$defs": {
    "UserMessage": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentPart"
          }
        }
      },
      "required": [
        "parts"
      ]
    },
    "ContentPart": {
      "description": "One piece of a user message.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "description": "Inline image. `data` is base64 of the raw bytes.",
          "type": "object",
          "properties": {
            "media_type": {
              "type": "string"
            },
            "data": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "required": [
            "type",
            "media_type",
            "data"
          ]
        },
        {
          "description": "Uploaded attachment served by the daemon's HTTP asset route.",
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            },
            "media_type": {
              "type": "string"
            },
            "size": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "attachment"
            }
          },
          "required": [
            "type",
            "asset_id",
            "name",
            "media_type",
            "size"
          ]
        },
        {
          "description": "`@path` mention resolved relative to the thread cwd.",
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "file_mention"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "description": "Inert reference to an existing Kybern thread. Selecting or rendering it\nnever reads, wakes, or sends to the referenced thread.",
          "type": "object",
          "properties": {
            "thread_id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string"
            },
            "project_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "thread_reference"
            }
          },
          "required": [
            "type",
            "thread_id",
            "title"
          ]
        },
        {
          "description": "A user-selected agent skill. Drivers translate this into the provider's\nnative invocation syntax instead of treating a lookalike `$NAME` as a\nskill accidentally.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "description": "Canonical `SKILL.md` path returned by the provider catalog. Codex\nrequires it for its structured `skill` turn input; other drivers\nmay use only the name.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "skill"
            }
          },
          "required": [
            "type",
            "name",
            "path"
          ]
        },
        {
          "description": "A provider plugin or app the user pulled in with `@name`, such as\nCodex's Computer Use. `path` is the provider's own id for it\n(`plugin://name@marketplace` or `app://connector-id`); drivers without\na structured form send the mention as text.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "display_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "mention"
            }
          },
          "required": [
            "type",
            "name",
            "path"
          ]
        },
        {
          "description": "A message from another thread (or from Kybern itself when\n`from_thread_id` is `None`). Providers receive it as flattened text; see\n[`thread_message_text`].",
          "type": "object",
          "properties": {
            "message_id": {
              "description": "The `thread_messages` row id; also the queued or steered message id.",
              "type": "string",
              "format": "uuid"
            },
            "from_thread_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "from_title": {
              "type": "string"
            },
            "purpose": {
              "$ref": "#/$defs/ThreadMessagePurpose"
            },
            "reply_to": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "body": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "thread_message"
            }
          },
          "required": [
            "type",
            "message_id",
            "from_title",
            "purpose",
            "body"
          ]
        },
        {
          "description": "A batch of delegated-agent outcomes delivered to the delegating thread.\nProviders receive it as flattened text; see [`agent_results_text`].",
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AgentResultItem"
              }
            },
            "type": {
              "type": "string",
              "const": "agent_results"
            }
          },
          "required": [
            "type",
            "items"
          ]
        }
      ]
    },
    "ThreadMessagePurpose": {
      "description": "Why a message exists. `Task` is a delegation brief; `Warning` comes from\nKybern itself (for example a file ownership clash).",
      "type": "string",
      "enum": [
        "task",
        "message",
        "question",
        "reply",
        "warning"
      ]
    },
    "AgentResultItem": {
      "description": "One delegated agent's outcome inside an [`ContentPart::AgentResults`] batch.",
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ProviderKind"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/DelegationRole",
          "default": "general"
        },
        "status": {
          "$ref": "#/$defs/DelegationStatus"
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "$ref": "#/$defs/DelegationWorkspace",
          "default": "shared"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "diffstat": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiffStat"
            },
            {
              "type": "null"
            }
          ]
        },
        "files_touched": {
          "description": "At most 50.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DelegationConflict"
          }
        }
      },
      "required": [
        "task_id",
        "thread_id",
        "title",
        "provider",
        "status"
      ]
    },
    "ProviderKind": {
      "description": "Coding agent backends the daemon can drive. Each has its own native driver.",
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "opencode",
        "pi",
        "omp",
        "cursor"
      ]
    },
    "DelegationRole": {
      "description": "What the delegating agent asked this child to be.",
      "type": "string",
      "enum": [
        "implementation",
        "research",
        "review",
        "design",
        "test",
        "general"
      ]
    },
    "DelegationStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        {
          "description": "Cut off by a daemon restart.",
          "type": "string",
          "const": "interrupted"
        }
      ]
    },
    "DelegationWorkspace": {
      "description": "Where a delegated child works.",
      "oneOf": [
        {
          "description": "The parent's checkout and branch.",
          "type": "string",
          "const": "shared"
        },
        {
          "description": "Its own git worktree on `kybern/<child-id>`, seeded from the parent's\ncurrent uncommitted state.",
          "type": "string",
          "const": "worktree"
        }
      ]
    },
    "DiffStat": {
      "description": "Files and lines changed between two commits.",
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "additions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "files",
        "additions",
        "deletions"
      ]
    },
    "DelegationConflict": {
      "description": "A shared-checkout edit that landed on a path a sibling delegation owns.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Repo-relative path that was edited.",
          "type": "string"
        },
        "owner_thread_id": {
          "description": "The sibling thread whose `owns` globs cover `path`.",
          "type": "string",
          "format": "uuid"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "path",
        "owner_thread_id",
        "at"
      ]
    }
  }
}
