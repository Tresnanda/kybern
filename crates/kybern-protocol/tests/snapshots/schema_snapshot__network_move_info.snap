---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(MoveInfo)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MoveInfo",
  "description": "A thread moved with \"Continue on…\" (design §7.2). `departing` holds the lease: the thread refuses\nsends until the target confirms (`departed`, read-only with a link to `peer_thread_id`) or the move\nis aborted (the field goes away). The daemon sets it; a stale copy of the thread never changes it.",
  "type": "object",
  "properties": {
    "state": {
      "$ref": "#/$defs/MoveState"
    },
    "peer": {
      "type": "string"
    },
    "peer_name": {
      "description": "The target's name when the move started, for the banner while it is offline.",
      "type": "string"
    },
    "peer_thread_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "lease_until": {
      "description": "While `departing`: when the lease ends unless it is renewed.",
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "branch": {
      "description": "The branch and snapshot commit the move carries.",
      "type": [
        "string",
        "null"
      ]
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "uncertain": {
      "description": "The commit request went out and no answer came back, so the target may or may not have the\nthread. The lease no longer expires; Retry asks the target, Abandon gives up.",
      "type": "boolean"
    }
  },
  "required": [
    "state",
    "peer",
    "operation_id"
  ],
  "$defs": {
    "MoveState": {
      "type": "string",
      "enum": [
        "departing",
        "departed",
        "arrived"
      ]
    }
  }
}
