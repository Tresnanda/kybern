  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PortForward",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "machine_id": {
      "type": "string"
    },
    "machine_name": {
      "type": "string"
    },
    "remote_port": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0,
      "maximum": 65535
    },
    "local_port": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0,
      "maximum": 65535
    },
    "connections": {
      "description": "Connections open right now.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "machine_id",
    "machine_name",
    "remote_port",
    "local_port",
    "connections",
    "created_at"
  ]
