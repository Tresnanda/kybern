---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(PortForward)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PortForward",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "machine_id": {
      "type": "string"
    },
    "machine_name": {
      "type": "string"
    },
    "remote_port": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0,
      "maximum": 65535
    },
    "local_port": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0,
      "maximum": 65535
    },
    "connections": {
      "description": "Connections open right now.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "rtt_ms": {
      "description": "The round trip to the machine, measured when the forward was opened, in milliseconds.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "https_available": {
      "description": "The machine can serve this forward over HTTP/2 (`https: true` in `ports.forward`).",
      "type": "boolean"
    },
    "https_port": {
      "description": "The HTTPS (HTTP/2) listener of this forward, once asked for.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint16",
      "minimum": 0,
      "maximum": 65535
    },
    "https_certificate": {
      "description": "The PEM certificate the HTTPS listener presents: Kybern's web views trust exactly this certificate for\n`localhost`, and only for this listener's pages. It is generated per install and never added to a trust store.",
      "type": [
        "string",
        "null"
      ]
    },
    "https_certificate_sha256": {
      "description": "Its SHA-256 fingerprint (lowercase hex of the DER).",
      "type": [
        "string",
        "null"
      ]
    },
    "route_via": {
      "description": "The member new connections travel through when it reaches the machine much faster than the direct route\n(ADE-126). Absent on the direct route.",
      "anyOf": [
        {
          "$ref": "#/$defs/PortRouteVia"
        },
        {
          "type": "null"
        }
      ]
    },
    "loading": {
      "description": "A page load in progress over this forward, while it is still fetching. Absent when nothing is loading.",
      "anyOf": [
        {
          "$ref": "#/$defs/PortLoad"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "description": "A preview's forward, stopped when the page's last tab closes; absent for a manual one.",
      "$ref": "#/$defs/PortForwardOrigin"
    }
  },
  "required": [
    "id",
    "machine_id",
    "machine_name",
    "remote_port",
    "local_port",
    "connections",
    "created_at"
  ],
  "$defs": {
    "PortRouteVia": {
      "description": "The member a forward's connections are relayed through.",
      "type": "object",
      "properties": {
        "machine_id": {
          "type": "string"
        },
        "machine_name": {
          "type": "string"
        }
      },
      "required": [
        "machine_id",
        "machine_name"
      ]
    },
    "PortLoad": {
      "description": "What a forward has fetched for the page that is loading now. A load starts with the first request after a quiet\nmoment and ends when no request has been open for a short while.",
      "type": "object",
      "properties": {
        "received_bytes": {
          "description": "Response bytes that crossed the network for this load so far (compressed, as they travelled).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cached_bytes": {
          "description": "Response bytes answered from this machine's cache of the dev server's responses.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "expected_bytes": {
          "description": "What the previous complete load of this forward transferred, as an estimate of the whole.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "bytes_per_second": {
          "description": "The transfer rate over the last few seconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "open_requests": {
          "description": "Requests not yet answered in full.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "elapsed_ms": {
          "description": "How long the load has run, in milliseconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "received_bytes",
        "bytes_per_second",
        "open_requests",
        "elapsed_ms"
      ]
    },
    "PortForwardOrigin": {
      "description": "Why a forward exists ([`PortsForwardParams::origin`]). Daemons before 0.21.5 leave it out, and clients read that as manual.",
      "oneOf": [
        {
          "description": "Forwarded by hand (\"Forward a port…\", `kybern ports forward`): it stays until it is stopped.",
          "type": "string",
          "const": "manual"
        },
        {
          "description": "Opened to show a page in a preview: the app that showed it stops it when the page's last tab closes.",
          "type": "string",
          "const": "preview"
        }
      ]
    }
  }
}
