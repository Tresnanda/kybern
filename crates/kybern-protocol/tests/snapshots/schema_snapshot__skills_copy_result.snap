---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(SkillsCopyResult)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillsCopyResult",
  "type": "object",
  "properties": {
    "source": {
      "description": "The machine that sends it.",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "hash": {
      "description": "The version that is sent (a queued copy sends the folder as it is when it is delivered).",
      "type": "string"
    },
    "files": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "bytes": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "skipped": {
      "description": "What the copy leaves out.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SkillCopyOutcome"
      }
    }
  },
  "required": [
    "source",
    "name",
    "hash",
    "files",
    "bytes",
    "targets"
  ],
  "$defs": {
    "SkillCopyOutcome": {
      "type": "object",
      "properties": {
        "machine_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/SkillCopyState"
        },
        "outbox_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "placed": {
          "description": "For `done`: each home.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkillPlaced"
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "machine_id",
        "name",
        "state"
      ]
    },
    "SkillCopyState": {
      "oneOf": [
        {
          "description": "In the outbox; it is delivered when the machine is reachable (at once when it is online).",
          "type": "string",
          "const": "queued"
        },
        {
          "description": "Copied (the source machine itself, which needs no transfer).",
          "type": "string",
          "const": "done"
        },
        {
          "description": "The machine runs a Kybern without skill copies.",
          "type": "string",
          "const": "unsupported"
        },
        {
          "description": "Nothing was copied there; `error` says why.",
          "type": "string",
          "const": "failed"
        }
      ]
    },
    "SkillPlaced": {
      "type": "object",
      "properties": {
        "home": {
          "$ref": "#/$defs/SkillHome"
        },
        "path": {
          "description": "The skill's folder on the target.",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/SkillPlaceAction"
        },
        "backup": {
          "description": "Where the replaced version was moved, for `replaced`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "home",
        "path",
        "action"
      ]
    },
    "SkillHome": {
      "description": "A harness's user skill folder.",
      "oneOf": [
        {
          "description": "`~/.agents/skills`: read by Codex, Cursor, OpenCode and omp.",
          "type": "string",
          "const": "agents"
        },
        {
          "description": "`$CLAUDE_CONFIG_DIR/skills` or `~/.claude/skills`: Claude Code, also read by Cursor and OpenCode.",
          "type": "string",
          "const": "claude"
        },
        {
          "description": "`$CODEX_HOME/skills` or `~/.codex/skills`: Codex, also read by Cursor.",
          "type": "string",
          "const": "codex"
        },
        {
          "description": "`~/.cursor/skills`.",
          "type": "string",
          "const": "cursor"
        },
        {
          "description": "`$XDG_CONFIG_HOME/opencode/skills` or `~/.config/opencode/skills`.",
          "type": "string",
          "const": "opencode"
        },
        {
          "description": "`$PI_CODING_AGENT_DIR/skills` or `~/.pi/agent/skills`: pi, also read by omp.",
          "type": "string",
          "const": "pi"
        },
        {
          "description": "`~/.omp/agent/skills` (or the active omp profile's).",
          "type": "string",
          "const": "omp"
        }
      ]
    },
    "SkillPlaceAction": {
      "description": "What happened to a skill in one home of a target.",
      "oneOf": [
        {
          "description": "It was not there; now it is.",
          "type": "string",
          "const": "written"
        },
        {
          "description": "A different version was there; it was moved to the backup and this one put in its place.",
          "type": "string",
          "const": "replaced"
        },
        {
          "description": "The same version was already there.",
          "type": "string",
          "const": "same"
        },
        {
          "description": "The folder there is a link to another home that this copy also writes.",
          "type": "string",
          "const": "linked"
        }
      ]
    }
  }
}
