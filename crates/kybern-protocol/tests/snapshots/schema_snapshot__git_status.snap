---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(GitStatus)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitStatus",
  "type": "object",
  "properties": {
    "is_git": {
      "type": "boolean"
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "dirty_files": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "ahead": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "behind": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "upstream": {
      "type": [
        "string",
        "null"
      ]
    },
    "remote_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "pull_request": {
      "description": "Open pull request for this branch, if `gh` knows one.",
      "anyOf": [
        {
          "$ref": "#/$defs/PullRequest"
        },
        {
          "type": "null"
        }
      ]
    },
    "repos": {
      "description": "Group threads: one entry per member in project order, excluded members\nincluded (`included: false`). The fields above are the primary's.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RepoGitStatus"
      }
    }
  },
  "required": [
    "is_git",
    "dirty_files",
    "ahead",
    "behind"
  ],
  "$defs": {
    "PullRequest": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "is_draft": {
          "type": "boolean"
        },
        "author": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "author_avatar_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "author_is_bot": {
          "type": "boolean"
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "additions": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "deletions": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "review_decision": {
          "description": "APPROVED | CHANGES_REQUESTED | REVIEW_REQUIRED",
          "type": [
            "string",
            "null"
          ]
        },
        "mergeable": {
          "description": "MERGEABLE | CONFLICTING | UNKNOWN",
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PrLabel"
          }
        },
        "checks_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrChecksSummary"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "number",
        "title",
        "url",
        "state",
        "head",
        "base",
        "is_draft",
        "author",
        "updated_at"
      ]
    },
    "PrLabel": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "color": {
          "description": "Hex without '#', as GitHub returns it.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "color"
      ]
    },
    "PrChecksSummary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "passed",
        "failed",
        "pending",
        "skipped"
      ]
    },
    "RepoGitStatus": {
      "description": "One member's git state in a group thread.",
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "included": {
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/MemberStatus"
        },
        "is_git": {
          "type": "boolean"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty_files": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "ahead": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "behind": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "upstream": {
          "type": [
            "string",
            "null"
          ]
        },
        "remote_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "pull_request": {
          "description": "Open pull request for this branch, if `gh` knows one.",
          "anyOf": [
            {
              "$ref": "#/$defs/PullRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "repos": {
          "description": "Group threads: one entry per member in project order, excluded members\nincluded (`included: false`). The fields above are the primary's.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepoGitStatus"
          }
        }
      },
      "required": [
        "repo",
        "name",
        "included",
        "status",
        "is_git",
        "dirty_files",
        "ahead",
        "behind"
      ]
    },
    "MemberStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ok"
          ]
        },
        {
          "description": "The folder is gone (deleted or renamed).",
          "type": "string",
          "const": "missing"
        },
        {
          "description": "The folder exists but is no longer a git repository.",
          "type": "string",
          "const": "not_git"
        }
      ]
    }
  }
}
