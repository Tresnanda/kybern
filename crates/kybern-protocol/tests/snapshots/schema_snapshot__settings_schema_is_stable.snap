---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(Settings)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Settings",
  "description": "User settings persisted at `<data_dir>/settings.json`.",
  "type": "object",
  "properties": {
    "default_provider": {
      "$ref": "#/$defs/ProviderKind",
      "default": "claude-code"
    },
    "default_permission_mode": {
      "$ref": "#/$defs/PermissionMode",
      "default": "supervised"
    },
    "worktrees_default": {
      "description": "Global default for new threads; projects can override.",
      "type": "boolean",
      "default": false
    },
    "generate_titles": {
      "description": "Generate thread titles with a model after the first turn.",
      "type": "boolean",
      "default": true
    },
    "title_provider": {
      "description": "Provider used for titles; falls back to the thread's own provider.",
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "providers": {
      "type": "object",
      "properties": {
        "claude-code": {
          "$ref": "#/$defs/ProviderSettings"
        },
        "codex": {
          "$ref": "#/$defs/ProviderSettings"
        },
        "cursor": {
          "$ref": "#/$defs/ProviderSettings"
        },
        "omp": {
          "$ref": "#/$defs/ProviderSettings"
        },
        "opencode": {
          "$ref": "#/$defs/ProviderSettings"
        },
        "pi": {
          "$ref": "#/$defs/ProviderSettings"
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "notifications": {
      "description": "Show OS notifications when a turn ends or needs approval.",
      "type": "boolean",
      "default": true
    },
    "auto_update_harnesses": {
      "description": "Check installed harnesses daily and update them when idle. Opt-in per environment.",
      "type": "boolean",
      "default": false
    },
    "background": {
      "description": "How the daemon trims CPU and memory while nothing needs it.",
      "$ref": "#/$defs/BackgroundSettings",
      "default": {
        "session_idle_minutes": 10,
        "max_idle_sessions": 4,
        "terminal_idle_minutes": 60,
        "daemon_idle_exit_minutes": 0,
        "save_power_on_battery": false
      }
    }
  },
  "$defs": {
    "ProviderKind": {
      "description": "Coding agent backends the daemon can drive. Each has its own native driver.",
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "opencode",
        "pi",
        "omp",
        "cursor"
      ]
    },
    "PermissionMode": {
      "description": "The four permission modes.",
      "oneOf": [
        {
          "description": "Every tool call that mutates or executes asks for approval.",
          "type": "string",
          "const": "supervised"
        },
        {
          "description": "File edits proceed; shell and network still ask.",
          "type": "string",
          "const": "accept-edits"
        },
        {
          "description": "The provider decides with its own safety heuristics; asks only when unsure.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Nothing asks. Sandboxing is the provider's problem.",
          "type": "string",
          "const": "full-access"
        }
      ]
    },
    "ProviderSettings": {
      "description": "Per-provider configuration in settings.json.",
      "type": "object",
      "properties": {
        "binary": {
          "description": "Absolute path to the executable; omit to look it up on PATH.",
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "description": "Default model for new threads.",
          "type": [
            "string",
            "null"
          ]
        },
        "env": {
          "description": "Extra environment variables for the provider process.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "BackgroundSettings": {
      "description": "Limits on what the daemon keeps alive after work finishes. Agent processes\nare resumed from the provider's own session on the next message, so\nreleasing one loses no conversation. Every value is in minutes; `0` turns\nthat limit off.",
      "type": "object",
      "properties": {
        "session_idle_minutes": {
          "description": "Minutes an idle thread keeps its agent process before the daemon\nreleases it. Threads that are running, awaiting approval, or have\nbackground work are never released.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 10
        },
        "max_idle_sessions": {
          "description": "Most idle agent processes kept warm at once. The least recently used\nare released first, even before their idle time is up.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 4
        },
        "terminal_idle_minutes": {
          "description": "Minutes a shell with no attached client and no foreground job stays\nopen before the daemon closes it.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 60
        },
        "daemon_idle_exit_minutes": {
          "description": "Minutes with no clients, agents, terminals, or queued work before the\ndaemon exits. Only for daemons the desktop app starts on demand: the\nCLI and remote clients do not restart a daemon that has exited.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "save_power_on_battery": {
          "description": "While the host runs on battery, release idle agent processes after\n`BATTERY_SESSION_IDLE` instead of `session_idle_minutes` and hold\nautomatic harness updates until power returns.",
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
