---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(SkillInventory)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkillInventory",
  "description": "`skills.inventory` / `peer.skills.inventory`: this machine's user skills.",
  "type": "object",
  "properties": {
    "homes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SkillHomeInfo"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MachineSkill"
      }
    },
    "os": {
      "description": "`macos`, `linux` or `windows`.",
      "type": "string"
    }
  },
  "required": [
    "homes",
    "skills"
  ],
  "$defs": {
    "SkillHomeInfo": {
      "description": "One home on one machine.",
      "type": "object",
      "properties": {
        "home": {
          "$ref": "#/$defs/SkillHome"
        },
        "path": {
          "description": "The absolute folder on that machine.",
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        }
      },
      "required": [
        "home",
        "path",
        "exists"
      ]
    },
    "SkillHome": {
      "description": "A harness's user skill folder.",
      "oneOf": [
        {
          "description": "`~/.agents/skills`: read by Codex, Cursor, OpenCode and omp.",
          "type": "string",
          "const": "agents"
        },
        {
          "description": "`$CLAUDE_CONFIG_DIR/skills` or `~/.claude/skills`: Claude Code, also read by Cursor and OpenCode.",
          "type": "string",
          "const": "claude"
        },
        {
          "description": "`$CODEX_HOME/skills` or `~/.codex/skills`: Codex, also read by Cursor.",
          "type": "string",
          "const": "codex"
        },
        {
          "description": "`~/.cursor/skills`.",
          "type": "string",
          "const": "cursor"
        },
        {
          "description": "`$XDG_CONFIG_HOME/opencode/skills` or `~/.config/opencode/skills`.",
          "type": "string",
          "const": "opencode"
        },
        {
          "description": "`$PI_CODING_AGENT_DIR/skills` or `~/.pi/agent/skills`: pi, also read by omp.",
          "type": "string",
          "const": "pi"
        },
        {
          "description": "`~/.omp/agent/skills` (or the active omp profile's).",
          "type": "string",
          "const": "omp"
        }
      ]
    },
    "MachineSkill": {
      "description": "A skill on one machine, with every home that holds it.",
      "type": "object",
      "properties": {
        "name": {
          "description": "The skill's folder relative to its home, `/`-separated (`better-ui`, `team/review`). It names the\nskill across machines and homes.",
          "type": "string"
        },
        "display_name": {
          "description": "The front matter's `name`, when it differs from the folder.",
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "copies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SkillCopyInfo"
          }
        }
      },
      "required": [
        "name",
        "copies"
      ]
    },
    "SkillCopyInfo": {
      "description": "One copy of a skill: the skill's folder in one home.",
      "type": "object",
      "properties": {
        "home": {
          "$ref": "#/$defs/SkillHome"
        },
        "path": {
          "description": "The skill's folder on that machine.",
          "type": "string"
        },
        "hash": {
          "description": "Lowercase hex SHA-256 over the copied files' paths and contents (`kybern-skill-v1`). Two copies\nwith the same hash are the same skill. Absent when the copy cannot be copied (too large, unreadable).",
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "description": "Bytes of the files a copy would carry.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "linked_to": {
          "description": "The folder is a symbolic link to this skill's copy in another home, so it is that copy.",
          "anyOf": [
            {
              "$ref": "#/$defs/SkillHome"
            },
            {
              "type": "null"
            }
          ]
        },
        "is_link": {
          "description": "The folder is a symbolic link (anywhere). A link is read through, and never replaced by a copy.",
          "type": "boolean"
        },
        "skipped": {
          "description": "Paths inside the skill a copy leaves out: links, `.git`, `node_modules`, secret-looking files.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "problem": {
          "description": "Why this copy cannot be sent, in words.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "home",
        "path",
        "size",
        "files"
      ]
    }
  }
}
