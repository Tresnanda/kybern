---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(PeerDelegateResult)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PeerDelegateResult",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "thread_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "$ref": "#/$defs/DelegationStatus"
    },
    "permission_mode": {
      "description": "The mode the child runs in after B clamped it.",
      "$ref": "#/$defs/PermissionMode"
    },
    "project_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "task_id",
    "thread_id",
    "status",
    "permission_mode"
  ],
  "$defs": {
    "DelegationStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        {
          "description": "Cut off by a daemon restart.",
          "type": "string",
          "const": "interrupted"
        }
      ]
    },
    "PermissionMode": {
      "description": "The four permission modes.",
      "oneOf": [
        {
          "description": "Every tool call that mutates or executes asks for approval.",
          "type": "string",
          "const": "supervised"
        },
        {
          "description": "File edits proceed; shell and network still ask.",
          "type": "string",
          "const": "accept-edits"
        },
        {
          "description": "The provider decides with its own safety heuristics; asks only when unsure.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Nothing asks. Sandboxing is the provider's problem.",
          "type": "string",
          "const": "full-access"
        }
      ]
    }
  }
}
