              "type": "boolean"
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "complete": {
              "type": "boolean"
            },
            "role": {
              "type": "string",
              "const": "assistant"
            }
          },
          "required": [
            "role",
            "id",
            "turn_id",
            "text",
            "at",
            "complete"
          ]
        },
        {
          "type": "object",
