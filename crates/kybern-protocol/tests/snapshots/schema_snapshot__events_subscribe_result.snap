        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "width",
        "height"
      ]
    },
    "VisualAsk": {
      "description": "What a visual asks the reader.",
      "type": "object",
      "properties": {
        "schema": {
          "description": "JSON Schema the answer must match, when the agent gave one."
        }
      }
    },
    "VisualAnswerRecord": {
      "description": "The receipt under an answered visual.",
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/VisualAnswerStatus"
        },
        "answer": true,
        "label": {
          "description": "The words the visual gave the answer (\"Layout B · Side panel\").",
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "status",
        "at"
      ]
    },
    "VisualAnswerStatus": {
      "description": "How a visual's question ended.",
      "oneOf": [
        {
          "description": "The reader sent an answer from the visual.",
          "type": "string",
          "const": "answered"
        },
        {
          "description": "The reader typed a message instead.",
          "type": "string",
          "const": "replied"
        },
        {
          "description": "The reader chose Skip.",
          "type": "string",
          "const": "skipped"
        },
        {
          "description": "The turn ended first.",
          "type": "string",
          "const": "cancelled"
        },
        {
          "description": "Nobody answered in time.",
          "type": "string",
          "const": "timed_out"
        }
      ]
    },
    "EventOrigin": {
      "description": "Ownership of provider output after it has been normalized by a driver.\nRoot output is eligible for the parent transcript; agent-owned output is\nretained as activity metadata and must never be promoted to the root answer.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "root"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "provider_thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "agent"
            }
          },
          "required": [
            "kind",
            "task_id"
          ]
        }
      ]
    },
    "UserMessage": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentPart"
          }
        }
      },
      "required": [
        "parts"
      ]
    },
    "ContentPart": {
      "description": "One piece of a user message.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "description": "Inline image. `data` is base64 of the raw bytes.",
          "type": "object",
          "properties": {
            "media_type": {
              "type": "string"
            },
            "data": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "required": [
            "type",
            "media_type",
            "data"
          ]
        },
        {
          "description": "Uploaded attachment served by the daemon's HTTP asset route.",
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            },
            "media_type": {
              "type": "string"
            },
            "size": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "attachment"
            }
          },
          "required": [
            "type",
            "asset_id",
            "name",
            "media_type",
            "size"
          ]
        },
        {
          "description": "`@path` mention resolved relative to the thread cwd.",
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "file_mention"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "description": "Inert reference to an existing Kybern thread. Selecting or rendering it\nnever reads, wakes, or sends to the referenced thread.",
          "type": "object",
          "properties": {
            "thread_id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string"
            },
            "project_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "thread_reference"
            }
          },
          "required": [
            "type",
            "thread_id",
            "title"
          ]
        },
        {
          "description": "A user-selected agent skill. Drivers translate this into the provider's\nnative invocation syntax instead of treating a lookalike `$NAME` as a\nskill accidentally.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "description": "Canonical `SKILL.md` path returned by the provider catalog. Codex\nrequires it for its structured `skill` turn input; other drivers\nmay use only the name.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "skill"
            }
          },
          "required": [
            "type",
            "name",
            "path"
          ]
        },
        {
          "description": "A provider plugin or app the user pulled in with `@name`, such as\nCodex's Computer Use. `path` is the provider's own id for it\n(`plugin://name@marketplace` or `app://connector-id`); drivers without\na structured form send the mention as text.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "display_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "mention"
            }
          },
          "required": [
            "type",
            "name",
            "path"
          ]
        },
        {
          "description": "A message from another thread (or from Kybern itself when\n`from_thread_id` is `None`). Providers receive it as flattened text; see\n[`thread_message_text`].",
          "type": "object",
          "properties": {
            "message_id": {
              "description": "The `thread_messages` row id; also the queued or steered message id.",
              "type": "string",
              "format": "uuid"
            },
            "from_thread_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "from_title": {
              "type": "string"
            },
            "purpose": {
              "$ref": "#/$defs/ThreadMessagePurpose"
            },
            "reply_to": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "body": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "thread_message"
            }
          },
          "required": [
            "type",
            "message_id",
            "from_title",
            "purpose",
            "body"
          ]
        },
        {
          "description": "A batch of delegated-agent outcomes delivered to the delegating thread.\nProviders receive it as flattened text; see [`agent_results_text`].",
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AgentResultItem"
              }
            },
            "type": {
              "type": "string",
              "const": "agent_results"
            }
          },
          "required": [
            "type",
            "items"
          ]
        },
        {
          "description": "A row Kybern itself adds to a conversation, such as \"Setup started\".\nClients draw it as a small system row, never a user bubble; it may sit in\nfront of the user's own parts. Providers never receive it as written:\nthe daemon swaps in its own instructions for the provider's copy, and a\ndriver that meets one flattens `text`.",
          "type": "object",
          "properties": {
            "kind": {
              "$ref": "#/$defs/SystemRowKind"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "system_row"
            }
          },
          "required": [
            "type",
            "kind",
            "text"
          ]
        }
      ]
    },
    "ThreadMessagePurpose": {
      "description": "Why a message exists. `Task` is a delegation brief; `Warning` comes from\nKybern itself (for example a file ownership clash).",
      "type": "string",
      "enum": [
        "task",
        "message",
        "question",
        "reply",
        "warning"
      ]
    },
    "AgentResultItem": {
      "description": "One delegated agent's outcome inside an [`ContentPart::AgentResults`] batch.",
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ProviderKind"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/DelegationRole",
          "default": "general"
        },
        "status": {
          "$ref": "#/$defs/DelegationStatus"
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "$ref": "#/$defs/DelegationWorkspace",
          "default": "shared"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "head_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_commit": {
          "description": "Worktree: the commit the worktree was seeded from.",
          "type": [
            "string",
            "null"
          ]
        },
        "diffstat": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiffStat"
            },
            {
              "type": "null"
            }
          ]
        },
        "files_touched": {
          "description": "At most 50.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DelegationConflict"
          }
        }
      },
      "required": [
        "task_id",
        "thread_id",
        "title",
        "provider",
        "status"
      ]
    },
    "SystemRowKind": {
      "description": "What a [`ContentPart::SystemRow`] announces.",
      "oneOf": [
        {
          "description": "The Coordinator's setup interview began (a new Coordinator without a\nbrief, or \"Redo setup\").",
          "type": "string",
          "const": "coordinator_setup"
        },
        {
          "description": "The user chose \"Tidy notes\": the Coordinator was asked to check outdated\nmemory notes. The provider's copy carries the instructions.",
          "type": "string",
          "const": "coordinator_tidy_notes"
        }
      ]
    },
    "ToolCall": {
      "description": "A tool invocation as shown in the transcript.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "input": true,
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "input"
      ]
    },
    "ApprovalRequest": {
      "description": "A pending or resolved request for the user to approve a tool call.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "tool_call_id": {
          "description": "Provider's tool-call id, when the provider exposes one.",
          "type": [
            "string",
            "null"
          ]
        },
        "tool_name": {
          "type": "string"
        },
        "input": {
          "description": "Provider-native input, rendered by the client (command, file path, diff, ...)."
        },
        "summary": {
          "description": "Human-readable one-line summary, e.g. `bash: git status`.",
          "type": "string"
        },
        "suggestions": {
          "description": "Provider-suggested \"always allow\" rules the client may offer.",
          "type": "array",
          "items": true,
          "default": []
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "questions": {
          "description": "The request's questions in one shape for every harness (see\n[`crate::user_input_questions`]); empty when it is not a question.\nOlder clients keep reading `input`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/UserInputQuestion"
          }
        }
      },
      "required": [
        "id",
        "thread_id",
        "turn_id",
        "tool_name",
        "input",
        "summary",
        "created_at"
      ]
    },
    "UserInputQuestion": {
      "description": "One question of a request, whatever harness asked it.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The key the answer goes under: the question text for Claude, the harness's id otherwise.",
          "type": "string"
        },
        "header": {
          "description": "A very short label, e.g. \"Layout\".",
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "description": "The question. Markdown.",
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UserInputOption"
          },
          "default": []
        },
        "multi_select": {
          "type": "boolean",
          "default": false
        },
        "allow_custom": {
          "description": "The user may write their own answer.",
          "type": "boolean",
          "default": false
        },
        "secret": {
          "description": "The answer is hidden in the transcript (Codex `isSecret`).",
          "type": "boolean",
          "default": false
        },
        "attachments": {
          "description": "The harness can take files and images with the answer (as paths in the text).",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "id",
        "question"
      ]
    },
    "UserInputOption": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "preview": {
          "description": "Text or code to show while the option is focused (Claude's `preview`). Markdown.",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "description": "The harness's own id for the option, when it answers with ids (Cursor).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "label"
      ]
    },
    "ApprovalDecision": {
      "oneOf": [
        {
          "description": "Answer a structured question or form using the provider-native payload.",
          "type": "object",
          "properties": {
            "response": true,
            "decision": {
              "type": "string",
              "const": "submit"
            }
          },
          "required": [
            "decision",
            "response"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "allow_once"
            }
          },
          "required": [
            "decision"
          ]
        },
        {
          "description": "Allow and, where the provider supports it, remember for the session.",
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "allow_always"
            }
          },
          "required": [
            "decision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "decision": {
              "type": "string",
              "const": "deny"
            }
          },
          "required": [
            "decision"
          ]
        }
      ]
    },
    "RequestAnswerer": {
      "description": "Who answered a request when it was not the user: a delegating agent.",
      "type": "object",
      "properties": {
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "thread_id",
        "title"
      ]
    },
    "StopReason": {
      "type": "string",
      "enum": [
        "completed",
        "interrupted",
        "max_turns",
        "error"
      ]
    },
    "Problem": {
      "description": "What went wrong in terms a person can act on, sent as an RPC error's `data.problem` (and in\nresults that report per-item failures). Additive: `message` stays the readable fallback, and\nclients that don't know a `kind` show `message`. Clients prefer their own copy keyed by\n`kind` and `subject`; `title` and `hint` are the daemon's fallback copy.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProblemKind"
        },
        "subject": {
          "description": "What the problem is about, e.g. `gh` for the GitHub CLI.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "description": "The one action that fixes it, when there is one.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProblemAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "secondary": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProblemAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "description": "The full technical error, for a Details disclosure; never the headline.",
          "type": [
            "string",
            "null"
          ]
        },
        "retryable": {
          "description": "Trying the same call again can succeed once the cause is fixed.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "kind"
      ]
    },
    "ProblemKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "conflict",
            "invalid_input",
            "not_found",
            "update_needed",
            "internal"
          ]
        },
        {
          "description": "A program Kybern needs isn't installed or can't be found.",
          "type": "string",
          "const": "tool_missing"
        },
        {
          "description": "Nobody is signed in where the call needs an account.",
          "type": "string",
          "const": "signed_out"
        },
        {
          "description": "The account is signed in but not allowed to do this.",
          "type": "string",
          "const": "permission"
        },
        {
          "description": "A machine or service can't be reached.",
          "type": "string",
          "const": "offline"
        }
      ]
    },
    "ProblemAction": {
      "description": "A button a client can offer. `id` is what the client does (`install_tool`, `sign_in`,\n`retry`, ...); `params` carry what it needs, e.g. `{ \"tool\": \"gh\" }`.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "params": true
      },
      "required": [
        "id",
        "label"
      ]
    },
    "RuntimeTask": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Provider-stable task, child-thread, tool-call, or process id.",
          "type": "string"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin_turn_id": {
          "description": "Kybern turn that launched this task. Background work can outlive it.",
          "type": "string",
          "format": "uuid"
        },
        "started_seq": {
          "description": "Event sequence that first anchored this task in the transcript. Older\nstored payloads use zero and are repaired by the event projector.",
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "updated_seq": {
          "description": "Sequence of the latest accepted task snapshot. Progress updates change\nthis value without changing `started_seq` or the row's visual position.",
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "kind": {
          "$ref": "#/$defs/RuntimeTaskKind"
        },
        "status": {
          "$ref": "#/$defs/RuntimeTaskStatus"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "backgrounded": {
          "type": "boolean",
          "default": false
        },
        "last_tool_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ]
        },
        "stats": {
          "$ref": "#/$defs/RuntimeTaskStats",
          "default": {}
        },
        "capabilities": {
          "$ref": "#/$defs/RuntimeTaskCapabilities",
          "default": {
            "stop": false,
            "background": false
          }
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "thread_id",
        "origin_turn_id",
        "kind",
        "status",
        "title",
        "started_at",
        "updated_at"
      ]
    },
    "RuntimeTaskKind": {
      "description": "A durable unit of work started by the provider while handling a thread.\n\nProviders expose different names for these (subagent, task, background\ncommand, monitor). Kybern preserves the provider type while normalizing the\nlifecycle so every client can render the same activity surface.",
      "type": "string",
      "enum": [
        "agent",
        "process",
        "monitor"
      ]
    },
    "NoticeLevel": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "OutsideRepoChange": {
      "description": "A deselected member whose original checkout changed during a turn of a\ngroup worktree thread (see `EventPayload::OutsideRepoChanged`).",
      "type": "object",
      "properties": {
        "repo": {
          "description": "Member path, relative to the project folder.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source_path": {
          "description": "Absolute path of the original checkout that changed.",
          "type": "string"
        },
        "dirty_files": {
          "description": "Files `git status --porcelain` reported changed at the end of the turn.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "head_moved": {
          "description": "HEAD moved during the turn (a commit, checkout or reset).",
          "type": "boolean"
        }
      },
      "required": [
        "repo",
        "name",
        "source_path"
      ]
    },
    "RotationReason": {
      "description": "Why a Coordinator's provider session was replaced (`ContextRotationStarted`).",
      "oneOf": [
        {
          "description": "The session's context passed the rotation budget at the end of a turn.",
          "type": "string",
          "const": "budget"
        },
        {
          "description": "The session was released for idleness past half the budget.",
          "type": "string",
          "const": "idle"
        },
        {
          "description": "The user asked for a refresh (`coordinator.refresh_context`).",
          "type": "string",
          "const": "manual"
        },
        {
          "description": "The Coordinator moved to another harness, model or account.",
          "type": "string",
          "const": "harness_switch"
        }
      ]
    },
    "HandoffStatus": {
      "description": "Whether the old session wrote a handoff that passed validation.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "written"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "description": "No usable handoff; the fresh session gets the facts and recent messages only.",
          "type": "object",
          "properties": {
            "why": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "missing"
            }
          },
          "required": [
            "status",
            "why"
          ]
        }
      ]
    },
    "RotationCarried": {
      "description": "Counts of what the daemon carried into a fresh Coordinator session.",
      "type": "object",
      "properties": {
        "children": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pull_requests": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "tasks": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "commits": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "head": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepoHead"
          }
        }
      },
      "required": [
        "children",
        "pull_requests",
        "tasks",
        "commits"
      ]
    },
    "RepoHead": {
      "description": "One repository's HEAD when a rotation happened.",
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha": {
          "type": "string"
        }
      },
      "required": [
        "repo",
        "sha"
      ]
    },
    "HarnessRef": {
      "description": "The harness and model on one side of a rotation.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ]
    },
    "HistoryItem": {
      "description": "One entry of the conversation a moved thread brings along.",
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/$defs/HistoryRole"
        },
        "text": {
          "type": "string"
        },
        "at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "tool": {
          "description": "The tool's name, for `tool` items.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "role",
        "text"
      ]
    },
    "HistoryRole": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "user",
            "assistant"
          ]
        },
        {
          "description": "A tool call, as a one-line summary without its output.",
          "type": "string",
          "const": "tool"
        },
        {
          "description": "A notice the thread showed (compaction, a fork or move link).",
          "type": "string",
          "const": "notice"
        }
      ]
    }
  }
}
