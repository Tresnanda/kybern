---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(EventsSubscribeResult)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventsSubscribeResult",
  "type": "object",
  "properties": {
    "subscription_id": {
      "type": "string",
      "format": "uuid"
    },
    "head_seq": {
      "description": "Latest persisted seq at subscribe time. Replay covers up to and including this.",
      "type": "integer",
      "format": "int64"
    },
    "replay_ready": {
      "description": "This daemon sends `events.ready` after replay, before live delivery resumes.",
      "type": "boolean",
      "default": false
    },
    "snapshot": {
      "description": "Sent instead of a replay when `gap_snapshot` was asked for and the gap was too large. It reflects\nexactly the events through `head_seq`; live events after it follow.",
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadsGetResult"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "subscription_id",
    "head_seq"
  ],
  "$defs": {
    "ThreadsGetResult": {
      "type": "object",
      "properties": {
        "notes": {
          "$ref": "#/$defs/ThreadNotes",
          "default": {
            "text": "",
            "revision": 0
          }
        },
        "pending_questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AsyncQuestionRequest"
          },
          "default": []
        },
        "provider_commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderCommand"
          },
          "default": []
        },
        "provider_usage": {
          "$ref": "#/$defs/ProviderUsage",
          "default": {}
        },
        "thread": {
          "$ref": "#/$defs/Thread"
        },
        "transcript": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TranscriptEntry"
          }
        },
        "next_before_seq": {
          "description": "Cursor for the next older page; absent when all earlier entries are present.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "pending_approvals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApprovalRequest"
          }
        },
        "runtime_tasks": {
          "description": "Durable latest-state task projection for this thread.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuntimeTask"
          }
        },
        "as_of_seq": {
          "description": "The event head read before this snapshot was projected: every event at or below it is reflected.\nOn one connection, a `threads.get` sent after an `events.subscribe` reads at or after that subscribe's\n`head_seq`. Older daemons leave it out.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "required": [
        "thread",
        "transcript",
        "pending_approvals"
      ]
    },
    "ThreadNotes": {
      "description": "A user-owned notepad, separate from the agent's conversation.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "text",
        "revision"
      ]
    },
    "AsyncQuestionRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AsyncQuestion"
          }
        }
      },
      "required": [
        "id",
        "questions"
      ]
    },
    "AsyncQuestion": {
      "description": "A provider question that does not pause the running turn.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "title"
      ]
    },
    "ProviderCommand": {
      "description": "A command advertised by a live harness's native protocol.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ]
    },
    "ProviderUsage": {
      "description": "Authoritative context occupancy, distinct from cumulative billable tokens.",
      "type": "object",
      "properties": {
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContextUsage"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/UsageLimit"
          }
        }
      }
    },
    "ContextUsage": {
      "type": "object",
      "properties": {
        "used_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "window_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "used_tokens",
        "window_tokens"
      ]
    },
    "UsageLimit": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "used_percent": {
          "type": "number",
          "format": "double"
        },
        "window_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "resets_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "required": [
        "name",
        "used_percent"
      ]
    },
    "Thread": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ProviderInstance"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "permission_mode": {
          "$ref": "#/$defs/PermissionMode"
        },
        "status": {
          "$ref": "#/$defs/ThreadStatus"
        },
        "worktree": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorktreeInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "description": "Working directory the agent runs in: the worktree path or the project path.",
          "type": "string"
        },
        "provider_session_id": {
          "description": "The provider's own session id once bound, used for resume and fork.",
          "type": [
            "string",
            "null"
          ]
        },
        "pinned": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_seq": {
          "description": "Sequence of the last event on this thread. Clients use it to detect gaps.",
          "type": "integer",
          "format": "int64"
        },
        "parent_thread_id": {
          "description": "Immutable parent for a Kybern-managed helper thread.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "coordinator_project_id": {
          "description": "Set when this thread is the project's Coordinator, the lead thread that\nplans and delegates. At most one non-archived thread per project.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "subagent": {
          "description": "Set when this thread mirrors one provider-native subagent. Such a thread\nis read-only: it records what the subagent said and did, and its\n`parent_thread_id` is the thread (or subagent thread) that launched it.\nClients that do not know about subagent threads must hide them from\nthread lists.",
          "anyOf": [
            {
              "$ref": "#/$defs/SubagentInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "delegation": {
          "description": "Set when this thread is a child another thread delegated work to with\n`kybern_agent_delegate`. Unlike `subagent` it is a normal, writable\nthread; `parent_thread_id` is the delegating thread. Clients that do\nnot know about delegation hide such threads from thread lists the same\nway they hide subagents.",
          "anyOf": [
            {
              "$ref": "#/$defs/DelegationInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "members": {
          "description": "Group threads: the members this thread started with, in project order. Never\nchanges when the project's members change. Empty for single-repo threads.\nFor a group worktree thread `worktree.path` and `cwd` are the container\nthat holds one worktree per included member.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ThreadMember"
          }
        },
        "origin": {
          "description": "Set when another machine started this thread (a remote delegation, a forwarded call). Only a\ndaemon sets it, from the live session, and it never changes. Absent for work the user started here.",
          "anyOf": [
            {
              "$ref": "#/$defs/Origin"
            },
            {
              "type": "null"
            }
          ]
        },
        "inbound": {
          "description": "Set on the hidden, read-only thread a machine keeps for one thread of another machine: it records\nthat thread's forwarded tool calls (`peer.tool.call`). Written once and never changes. Clients\nkeep such threads out of lists.",
          "anyOf": [
            {
              "$ref": "#/$defs/InboundInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "moved": {
          "description": "Set while \"Continue on…\" is moving this thread to another machine (`departing`: it refuses sends\nuntil the target confirms) and after it moved (`departed`: read-only, with a link to the thread\nthat continues the work). Only the daemon writes it, and a stale copy of the thread never changes it.",
          "anyOf": [
            {
              "$ref": "#/$defs/MoveInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "project_id",
        "title",
        "provider",
        "permission_mode",
        "status",
        "cwd",
        "pinned",
        "created_at",
        "updated_at",
        "last_seq"
      ]
    },
    "ProviderInstance": {
      "description": "A configured account/instance of a provider. `default` is created implicitly.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "instance": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "instance"
      ]
    },
    "ProviderKind": {
      "description": "Coding agent backends the daemon can drive. Each has its own native driver.",
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "opencode",
        "pi",
        "omp",
        "cursor",
        "antigravity",
        "grok-build"
      ]
    },
    "PermissionMode": {
      "description": "The four permission modes.",
      "oneOf": [
        {
          "description": "Every tool call that mutates or executes asks for approval.",
          "type": "string",
          "const": "supervised"
        },
        {
          "description": "File edits proceed; shell and network still ask.",
          "type": "string",
          "const": "accept-edits"
        },
        {
          "description": "The provider decides with its own safety heuristics; asks only when unsure.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Nothing asks. Sandboxing is the provider's problem.",
          "type": "string",
          "const": "full-access"
        }
      ]
    },
    "ThreadStatus": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "awaiting-approval",
        "failed",
        "archived"
      ]
    },
    "WorktreeInfo": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "branch"
      ]
    },
    "SubagentInfo": {
      "description": "Provider-native subagent metadata carried by a read-only child [`Thread`].\n\nThe title, model and effort live on the thread itself. This struct holds\nthe rest of what a subagent page needs and is refreshed (through\n`thread_updated`) whenever the parent's runtime task for it changes.",
      "type": "object",
      "properties": {
        "task_id": {
          "description": "Provider-stable id of the runtime task in the parent thread. Together\nwith the root thread it identifies this child thread.",
          "type": "string"
        },
        "root_thread_id": {
          "description": "The thread that owns the provider session. For a subagent launched by\nanother subagent this is the root, not `Thread::parent_thread_id`.\n`tasks.stop` and `tasks.background` accept the child thread id and\nresolve the session through it.",
          "type": "string",
          "format": "uuid"
        },
        "parent_turn_id": {
          "description": "Turn of the root thread that launched the subagent.",
          "type": "string",
          "format": "uuid"
        },
        "tool_call_id": {
          "description": "Tool call in the parent that launched it, when the provider has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "provider_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_type": {
          "description": "Provider agent type or role (`Explore`, `worker`, `task:general`).",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/RuntimeTaskStatus"
        },
        "backgrounded": {
          "type": "boolean",
          "default": false
        },
        "last_tool_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "description": "Latest progress or final result summary from the provider, as reported\n(see `progress` and `result` for the normalized one-line forms).",
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "description": "One live line while the subagent works: the provider's latest activity\ntext, else the last tool it used (`Using Read`). Cleared once it settles.",
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "description": "First line of the subagent's final answer once it settled (its last\nmessage, else the provider's result summary, else the failure message).",
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ]
        },
        "stats": {
          "$ref": "#/$defs/RuntimeTaskStats",
          "default": {}
        },
        "capabilities": {
          "description": "Whether `tasks.stop` / `tasks.background` currently work for it.",
          "$ref": "#/$defs/RuntimeTaskCapabilities",
          "default": {
            "stop": false,
            "background": false
          }
        },
        "transcript": {
          "description": "False when the harness only reports lifecycle (Pi/OMP and providers\nwithout native subagent forwarding): the transcript holds just the\nprompt and the outcome.",
          "type": "boolean",
          "default": false
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "task_id",
        "root_thread_id",
        "parent_turn_id",
        "status",
        "started_at"
      ]
    },
    "RuntimeTaskStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "waiting",
        "stopping",
        "completed",
        "failed",
        "stopped",
        "interrupted"
      ]
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ]
    },
    "RuntimeTaskStats": {
      "type": "object",
      "properties": {
        "token_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "tool_uses": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "cpu_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "rss_kb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "RuntimeTaskCapabilities": {
      "type": "object",
      "properties": {
        "stop": {
          "description": "The provider exposes a targeted stop operation for this task.",
          "type": "boolean",
          "default": false
        },
        "background": {
          "description": "The provider can detach this foreground task without interrupting it.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "DelegationInfo": {
      "description": "Delegation metadata carried by a child [`Thread`] created with\n`kybern_agent_delegate`. Refreshed through `thread_updated`.",
      "type": "object",
      "properties": {
        "task_id": {
          "description": "Stable id agents use to refer to this delegation.",
          "type": "string",
          "format": "uuid"
        },
        "operation_id": {
          "description": "Idempotency key of the delegate call.",
          "type": "string",
          "format": "uuid"
        },
        "parent_thread_id": {
          "description": "Duplicate of `Thread::parent_thread_id` for convenience.",
          "type": "string",
          "format": "uuid"
        },
        "depth": {
          "description": "1 for a direct child of a top-level thread.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "role": {
          "$ref": "#/$defs/DelegationRole",
          "default": "general"
        },
        "workspace": {
          "$ref": "#/$defs/DelegationWorkspace",
          "default": "shared"
        },
        "default_override": {
          "description": "Set when a Coordinator chose another harness or model than the default\nconfigured for this child's role.",
          "anyOf": [
            {
              "$ref": "#/$defs/DefaultOverride"
            },
            {
              "type": "null"
            }
          ]
        },
        "owns": {
          "description": "Globs relative to the checkout root this child owns (shared only).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/DelegationStatus"
        },
        "result": {
          "description": "The child's final assistant text of the completing turn (at most\n16 KiB, truncated with a marker).",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "files_touched": {
          "description": "Repo-relative paths the child edited, deduplicated, at most 200.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DelegationConflict"
          }
        },
        "base_commit": {
          "description": "Worktree: the snapshot commit the worktree was seeded from.",
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "description": "Worktree: `kybern/<child-id>`.",
          "type": [
            "string",
            "null"
          ]
        },
        "head_commit": {
          "description": "Worktree: HEAD when the child completed.",
          "type": [
            "string",
            "null"
          ]
        },
        "diffstat": {
          "description": "Worktree: `base_commit..head_commit`.",
          "anyOf": [
            {
              "$ref": "#/$defs/DiffStat"
            },
            {
              "type": "null"
            }
          ]
        },
        "worktree_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorktreeState"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "parent_notified": {
          "description": "Whether the delegating parent has been handed this outcome (delivered,\nsteered or queued). Cleared when the delegation reaches a terminal state\nand set once its `AgentResultItem` is out, so a restart can re-send an\noutcome that was still waiting in the debounce window. Rows written\nbefore this field existed read as `true`: nothing is re-sent.",
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "task_id",
        "operation_id",
        "parent_thread_id",
        "depth",
        "status",
        "started_at"
      ]
    },
    "DelegationRole": {
      "description": "What the delegating agent asked this child to be.",
      "type": "string",
      "enum": [
        "implementation",
        "research",
        "review",
        "design",
        "test",
        "general"
      ]
    },
    "DelegationWorkspace": {
      "description": "Where a delegated child works.",
      "oneOf": [
        {
          "description": "The parent's checkout and branch.",
          "type": "string",
          "const": "shared"
        },
        {
          "description": "Its own git worktree on `kybern/<child-id>`, seeded from the parent's\ncurrent uncommitted state.",
          "type": "string",
          "const": "worktree"
        }
      ]
    },
    "DefaultOverride": {
      "description": "A Coordinator delegation that used another harness or model than the\ndefault configured for its role. `provider` and `model` are the default that\nwas set aside (the child's own are on its thread), so a client can write\n\"Claude Opus 5.5 · instead of the Sonnet default: <reason>\".",
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/ProviderInstance"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "The Coordinator's reason, as it passed it in `override_reason`.",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "reason"
      ]
    },
    "DelegationStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        {
          "description": "Cut off by a daemon restart.",
          "type": "string",
          "const": "interrupted"
        }
      ]
    },
    "DelegationConflict": {
      "description": "A shared-checkout edit that landed on a path a sibling delegation owns.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Repo-relative path that was edited.",
          "type": "string"
        },
        "owner_thread_id": {
          "description": "The sibling thread whose `owns` globs cover `path`.",
          "type": "string",
          "format": "uuid"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "path",
        "owner_thread_id",
        "at"
      ]
    },
    "DiffStat": {
      "description": "Files and lines changed between two commits.",
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "additions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "files",
        "additions",
        "deletions"
      ]
    },
    "WorktreeState": {
      "description": "State of a delegated child's own worktree (`DelegationWorkspace::Worktree`).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "active",
            "removed"
          ]
        },
        {
          "description": "Left on disk because it was dirty or its branch is unmerged.",
          "type": "string",
          "const": "kept"
        }
      ]
    },
    "ThreadMember": {
      "description": "A group thread's record of one member, fixed when the thread starts.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Member path, relative to the project folder and to the thread cwd.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "included": {
          "description": "False when the user left this member out of a worktree chat: it has no\nworktree and the agent is told to treat `source_path` as read-only.",
          "type": "boolean"
        },
        "source_path": {
          "description": "Absolute path of the member's checkout when the thread started.",
          "type": "string"
        },
        "worktree": {
          "description": "Worktree mode: this member's worktree (path inside the container, branch `kybern/<thread-id>`).",
          "anyOf": [
            {
              "$ref": "#/$defs/WorktreeInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "base_branch": {
          "description": "Branch the worktree forked from (worktree) or the branch checked out at start (local).",
          "type": [
            "string",
            "null"
          ]
        },
        "base_commit": {
          "description": "Commit the worktree forked from.",
          "type": [
            "string",
            "null"
          ]
        },
        "worktree_state": {
          "description": "Set once cleanup has run for this member.",
          "anyOf": [
            {
              "$ref": "#/$defs/WorktreeState"
            },
            {
              "type": "null"
            }
          ]
        },
        "missing": {
          "description": "The member was missing or not a repository when the thread started, so\nit is not available to this thread.",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "name",
        "included",
        "source_path"
      ]
    },
    "Origin": {
      "description": "Where work that another machine started came from. Only a daemon sets it, and it never changes.",
      "type": "object",
      "properties": {
        "machine_id": {
          "type": "string"
        },
        "machine_name": {
          "type": "string"
        },
        "thread_id": {
          "type": [
