---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(PeerPortsPrepareParams)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PeerPortsPrepareParams",
  "description": "Authorize a forward without connecting to the destination service.",
  "type": "object",
  "properties": {
    "forward_id": {
      "type": "string",
      "format": "uuid"
    },
    "port": {
      "type": "integer",
      "format": "uint16",
      "minimum": 0,
      "maximum": 65535
    },
    "direct_version": {
      "description": "The direct handshake the caller speaks: 2 for `ports.direct.v2` (an authorized socket waits for a mode\nbyte). Absent means 1.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint8",
      "minimum": 0,
      "maximum": 255
    }
  },
  "required": [
    "forward_id",
    "port"
  ]
}
