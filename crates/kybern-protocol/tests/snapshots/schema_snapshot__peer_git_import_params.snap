---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(PeerGitImportParams)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PeerGitImportParams",
  "description": "`peer.git.import`: the bundle is complete; check it and import it into the checkout that matches\n`repo`, under `refs/kybern/incoming/<operation_id>`.",
  "type": "object",
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "total": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "sha256": {
      "description": "SHA-256 of the whole bundle, hex.",
      "type": "string"
    },
    "commit": {
      "description": "The commit the bundle is for.",
      "type": "string"
    },
    "repo": {
      "$ref": "#/$defs/RepoIdentity"
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "operation_id",
    "total",
    "sha256",
    "commit",
    "repo"
  ],
  "$defs": {
    "RepoIdentity": {
      "description": "What makes two checkouts the same logical project on different machines.",
      "type": "object",
      "properties": {
        "root_commit": {
          "description": "The smallest hash in `git rev-list --max-parents=0 HEAD`.",
          "type": [
            "string",
            "null"
          ]
        },
        "remote": {
          "description": "The `origin` URL normalized to `host/owner/repo`: lowercase, no scheme, user or `.git`.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
