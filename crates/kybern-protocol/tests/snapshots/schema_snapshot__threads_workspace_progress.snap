---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(ThreadsWorkspaceProgress)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadsWorkspaceProgress",
  "description": "Params of the transient `threads.workspace_progress` notification, sent while\n`threads.create` prepares worktrees: before each repository and once at the\nend. Single-repo worktree threads send it too (`total: 1`). Not an event.",
  "type": "object",
  "properties": {
    "thread_id": {
      "type": "string",
      "format": "uuid"
    },
    "done": {
      "description": "Repositories whose worktree exists.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "current": {
      "description": "Member being created (its path); absent for single-repo threads and at the end.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "thread_id",
    "done",
    "total"
  ]
}
