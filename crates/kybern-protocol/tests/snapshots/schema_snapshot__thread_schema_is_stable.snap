---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(Thread)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thread",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/ProviderInstance"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "permission_mode": {
      "$ref": "#/$defs/PermissionMode"
    },
    "status": {
      "$ref": "#/$defs/ThreadStatus"
    },
    "worktree": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorktreeInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "cwd": {
      "description": "Working directory the agent runs in: the worktree path or the project path.",
      "type": "string"
    },
    "provider_session_id": {
      "description": "The provider's own session id once bound, used for resume and fork.",
      "type": [
        "string",
        "null"
      ]
    },
    "pinned": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_seq": {
      "description": "Sequence of the last event on this thread. Clients use it to detect gaps.",
      "type": "integer",
      "format": "int64"
    }
  },
  "required": [
    "id",
    "project_id",
    "title",
    "provider",
    "permission_mode",
    "status",
    "cwd",
    "pinned",
    "created_at",
    "updated_at",
    "last_seq"
  ],
  "$defs": {
    "ProviderInstance": {
      "description": "A configured account/instance of a provider. `default` is created implicitly.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "instance": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "instance"
      ]
    },
    "ProviderKind": {
      "description": "Coding agent backends the daemon can drive. Each has its own native driver.",
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "opencode",
        "pi",
        "omp",
        "cursor"
      ]
    },
    "PermissionMode": {
      "description": "The four permission modes, mirroring T3 Code.",
      "oneOf": [
        {
          "description": "Every tool call that mutates or executes asks for approval.",
          "type": "string",
          "const": "supervised"
        },
        {
          "description": "File edits proceed; shell and network still ask.",
          "type": "string",
          "const": "accept-edits"
        },
        {
          "description": "The provider decides with its own safety heuristics; asks only when unsure.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Nothing asks. Sandboxing is the provider's problem.",
          "type": "string",
          "const": "full-access"
        }
      ]
    },
    "ThreadStatus": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "awaiting-approval",
        "failed",
        "archived"
      ]
    },
    "WorktreeInfo": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "branch"
      ]
    }
  }
}
