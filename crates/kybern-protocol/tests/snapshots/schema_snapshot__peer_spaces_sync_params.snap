expression: schema_for!(PeerSpacesSyncParams)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PeerSpacesSyncParams",
  "type": "object",
  "properties": {
    "digest": {
      "type": "string"
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OpEnvelope"
      },
      "default": []
    }
  },
  "required": [
    "digest"
  ],
  "$defs": {
    "OpEnvelope": {
      "description": "An operation as it is stored and sent.",
      "type": "object",
      "properties": {
        "id": {
          "description": "`sha256(body)` as lowercase hex; the primary key.",
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "signer": {
          "type": "string"
        },
        "signature": {
          "description": "`ed25519(signer, OP_SIGNATURE_DOMAIN || body)`, standard base64.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "body",
        "signer",
        "signature"
      ]
    }
  }
}
