---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(ThreadEvent)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadEvent",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "format": "int64"
    },
    "thread_id": {
      "type": "string",
      "format": "uuid"
    },
    "turn_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "seq",
    "thread_id",
    "at"
  ],
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "thread": {
          "$ref": "#/$defs/Thread"
        },
        "kind": {
          "type": "string",
          "const": "thread_created"
        }
      },
      "required": [
        "kind",
        "thread"
      ]
    },
    {
      "description": "Title, model, permission mode, pin, status or session changed.",
      "type": "object",
      "properties": {
        "thread": {
          "$ref": "#/$defs/Thread"
        },
        "kind": {
          "type": "string",
          "const": "thread_updated"
        }
      },
      "required": [
        "kind",
        "thread"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "thread_archived"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message": {
          "$ref": "#/$defs/QueuedMessage"
        },
        "kind": {
          "type": "string",
          "const": "message_queued"
        }
      },
      "required": [
        "kind",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "const": "message_removed"
        }
      },
      "required": [
        "kind",
        "message_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "message": {
          "$ref": "#/$defs/UserMessage"
        },
        "kind": {
          "type": "string",
          "const": "turn_started"
        }
      },
      "required": [
        "kind",
        "message_id",
        "message"
      ]
    },
    {
      "description": "Provider assigned or confirmed its own session id.",
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "const": "provider_session_bound"
        }
      },
      "required": [
        "kind",
        "session_id"
      ]
    },
    {
      "description": "The daemon closed the agent process while the thread was idle. The\nnext message resumes the provider session; nothing is lost.",
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/SessionReleaseReason"
        },
        "kind": {
          "type": "string",
          "const": "provider_session_released"
        }
      },
      "required": [
        "kind",
        "reason"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin",
          "default": {
            "kind": "root"
          }
        },
        "delta": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "assistant_text_delta"
        }
      },
      "required": [
        "kind",
        "message_id",
        "delta"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin"
        },
        "source": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "image_received"
        }
      },
      "required": [
        "kind",
        "id",
        "origin",
        "source"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin",
          "default": {
            "kind": "root"
          }
        },
        "delta": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "assistant_thinking_delta"
        }
      },
      "required": [
        "kind",
        "message_id",
        "delta"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin",
          "default": {
            "kind": "root"
          }
        },
        "text": {
          "type": "string"
        },
        "thinking": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "const": "assistant_message_completed"
        }
      },
      "required": [
        "kind",
        "message_id",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "call": {
          "$ref": "#/$defs/ToolCall"
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin",
          "default": {
            "kind": "root"
          }
        },
        "kind": {
          "type": "string",
          "const": "tool_call_started"
        }
      },
      "required": [
        "kind",
        "call"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tool_call_id": {
          "type": "string"
        },
        "delta": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "tool_call_output_delta"
        }
      },
      "required": [
        "kind",
        "tool_call_id",
        "delta"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tool_call_id": {
          "type": "string"
        },
        "output": true,
        "is_error": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "const": "tool_call_completed"
        }
      },
      "required": [
        "kind",
        "tool_call_id",
        "output",
        "is_error"
      ]
    },
    {
      "description": "A provider-owned subagent, process, or monitor became visible.",
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/RuntimeTask"
        },
        "kind": {
          "type": "string",
          "const": "runtime_task_started"
        }
      },
      "required": [
        "kind",
        "task"
      ]
    },
    {
      "description": "Full latest-state snapshot for an existing provider-owned task.",
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/RuntimeTask"
        },
        "kind": {
          "type": "string",
          "const": "runtime_task_updated"
        }
      },
      "required": [
        "kind",
        "task"
      ]
    },
    {
      "description": "Terminal snapshot retained in the event log for history and recovery.",
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/RuntimeTask"
        },
        "kind": {
          "type": "string",
          "const": "runtime_task_completed"
        }
      },
      "required": [
        "kind",
        "task"
      ]
    },
    {
      "type": "object",
      "properties": {
        "request": {
          "$ref": "#/$defs/AsyncQuestionRequest"
        },
        "kind": {
          "type": "string",
          "const": "async_questions_requested"
        }
      },
      "required": [
        "kind",
        "request"
      ]
    },
    {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "message": {
          "$ref": "#/$defs/UserMessage"
        },
        "kind": {
          "type": "string",
          "const": "async_questions_answered"
        }
      },
      "required": [
        "kind",
        "request_id",
        "answers",
        "message_id",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "approval": {
          "$ref": "#/$defs/ApprovalRequest"
        },
        "kind": {
          "type": "string",
          "const": "user_input_requested"
        }
      },
      "required": [
        "kind",
        "approval"
      ]
    },
    {
      "type": "object",
      "properties": {
        "approval": {
          "$ref": "#/$defs/ApprovalRequest"
        },
        "kind": {
          "type": "string",
          "const": "approval_requested"
        }
      },
      "required": [
        "kind",
        "approval"
      ]
    },
    {
      "type": "object",
      "properties": {
        "approval_id": {
          "type": "string",
          "format": "uuid"
        },
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        },
        "kind": {
          "type": "string",
          "const": "approval_resolved"
        }
      },
      "required": [
        "kind",
        "approval_id",
        "decision"
      ]
    },
    {
      "type": "object",
      "properties": {
        "stop_reason": {
          "$ref": "#/$defs/StopReason"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "terminal_message_id": {
          "description": "Durable identity of the terminal non-empty root assistant message.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "const": "turn_completed"
        }
      },
      "required": [
        "kind",
        "stop_reason",
        "usage",
        "duration_ms"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "turn_failed"
        }
      },
      "required": [
        "kind",
        "error"
      ]
    },
    {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderCommand"
          }
        },
        "kind": {
          "type": "string",
          "const": "provider_commands_updated"
        }
      },
      "required": [
        "kind",
        "commands"
      ]
    },
    {
      "type": "object",
      "properties": {
        "usage": {
          "$ref": "#/$defs/ProviderUsage"
        },
        "kind": {
          "type": "string",
          "const": "provider_usage_updated"
        }
      },
      "required": [
        "kind",
        "usage"
      ]
    },
    {
      "description": "Provider emitted an informational notice (compaction, status, warnings).",
      "type": "object",
      "properties": {
        "level": {
          "$ref": "#/$defs/NoticeLevel"
        },
        "text": {
          "type": "string"
        },
        "data": true,
        "kind": {
          "type": "string",
          "const": "provider_notice"
        }
      },
      "required": [
        "kind",
        "level",
        "text"
      ]
    },
    {
      "description": "A git checkpoint was taken or completed for this turn.",
      "type": "object",
      "properties": {
        "checkpoint": {
          "$ref": "#/$defs/Checkpoint"
        },
        "kind": {
          "type": "string",
          "const": "checkpoint_updated"
        }
      },
      "required": [
        "kind",
        "checkpoint"
      ]
    },
    {
      "description": "The working tree was reset to the state before `turn_id`.",
      "type": "object",
      "properties": {
        "to_turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "commit": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "workspace_reverted"
        }
      },
      "required": [
        "kind",
        "to_turn_id",
        "commit"
      ]
    }
  ],
  "$defs": {
    "Thread": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ProviderInstance"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "permission_mode": {
          "$ref": "#/$defs/PermissionMode"
        },
        "status": {
          "$ref": "#/$defs/ThreadStatus"
        },
        "worktree": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorktreeInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "description": "Working directory the agent runs in: the worktree path or the project path.",
          "type": "string"
        },
        "provider_session_id": {
          "description": "The provider's own session id once bound, used for resume and fork.",
          "type": [
            "string",
            "null"
          ]
        },
        "pinned": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_seq": {
          "description": "Sequence of the last event on this thread. Clients use it to detect gaps.",
          "type": "integer",
          "format": "int64"
        }
      },
      "required": [
        "id",
        "project_id",
        "title",
        "provider",
        "permission_mode",
        "status",
        "cwd",
        "pinned",
        "created_at",
        "updated_at",
        "last_seq"
      ]
    },
    "ProviderInstance": {
      "description": "A configured account/instance of a provider. `default` is created implicitly.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "instance": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "instance"
      ]
    },
    "ProviderKind": {
      "description": "Coding agent backends the daemon can drive. Each has its own native driver.",
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "opencode",
        "pi",
        "omp",
        "cursor"
      ]
    },
    "PermissionMode": {
      "description": "The four permission modes.",
      "oneOf": [
        {
          "description": "Every tool call that mutates or executes asks for approval.",
          "type": "string",
          "const": "supervised"
        },
        {
          "description": "File edits proceed; shell and network still ask.",
          "type": "string",
          "const": "accept-edits"
        },
        {
          "description": "The provider decides with its own safety heuristics; asks only when unsure.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Nothing asks. Sandboxing is the provider's problem.",
          "type": "string",
          "const": "full-access"
        }
      ]
    },
    "ThreadStatus": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "awaiting-approval",
        "failed",
        "archived"
      ]
    },
    "WorktreeInfo": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "branch"
      ]
    },
    "QueuedMessage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "message": {
          "$ref": "#/$defs/UserMessage"
        }
      },
      "required": [
        "id",
        "thread_id",
        "message"
      ]
    },
    "UserMessage": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentPart"
          }
        }
      },
      "required": [
        "parts"
      ]
    },
    "ContentPart": {
      "description": "One piece of a user message.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "description": "Inline image. `data` is base64 of the raw bytes.",
          "type": "object",
          "properties": {
            "media_type": {
              "type": "string"
            },
            "data": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "required": [
            "type",
            "media_type",
            "data"
          ]
        },
        {
          "description": "Uploaded attachment served by the daemon's HTTP asset route.",
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            },
            "media_type": {
              "type": "string"
            },
            "size": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "attachment"
            }
          },
          "required": [
            "type",
            "asset_id",
            "name",
            "media_type",
            "size"
          ]
        },
        {
          "description": "`@path` mention resolved relative to the thread cwd.",
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "file_mention"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "description": "A user-selected agent skill. Drivers translate this into the provider's\nnative invocation syntax instead of treating a lookalike `$NAME` as a\nskill accidentally.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "description": "Canonical `SKILL.md` path returned by the provider catalog. Codex\nrequires it for its structured `skill` turn input; other drivers\nmay use only the name.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "skill"
            }
          },
          "required": [
            "type",
            "name",
            "path"
          ]
        },
        {
          "description": "A provider plugin or app the user pulled in with `@name`, such as\nCodex's Computer Use. `path` is the provider's own id for it\n(`plugin://name@marketplace` or `app://connector-id`); drivers without\na structured form send the mention as text.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "display_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "mention"
            }
          },
          "required": [
            "type",
            "name",
            "path"
          ]
        }
      ]
    },
    "SessionReleaseReason": {
      "description": "Why the daemon closed an agent process. The thread's conversation is kept\nby the provider and resumes with the next message.",
      "oneOf": [
        {
          "description": "The user released a parked process to reconnect on the next message.",
          "type": "string",
          "const": "manual"
        },
        {
          "description": "The thread was idle for longer than `background.session_idle_minutes`.",
          "type": "string",
          "const": "idle"
        },
        {
          "description": "More idle processes were alive than `background.max_idle_sessions`.",
          "type": "string",
          "const": "capacity"
        },
        {
          "description": "The harness was closed so it could be updated.",
          "type": "string",
          "const": "update"
        },
        {
          "description": "The host is on battery and `background.save_power_on_battery` is on.",
          "type": "string",
          "const": "power"
        }
      ]
    },
    "EventOrigin": {
      "description": "Ownership of provider output after it has been normalized by a driver.\nRoot output is eligible for the parent transcript; agent-owned output is\nretained as activity metadata and must never be promoted to the root answer.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "root"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "provider_thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "agent"
            }
          },
          "required": [
            "kind",
            "task_id"
          ]
        }
      ]
    },
    "ToolCall": {
      "description": "A tool invocation as shown in the transcript.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "input": true,
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "input"
      ]
    },
    "RuntimeTask": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Provider-stable task, child-thread, tool-call, or process id.",
          "type": "string"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin_turn_id": {
          "description": "Kybern turn that launched this task. Background work can outlive it.",
          "type": "string",
          "format": "uuid"
        },
        "started_seq": {
          "description": "Event sequence that first anchored this task in the transcript. Older\nstored payloads use zero and are repaired by the event projector.",
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "updated_seq": {
          "description": "Sequence of the latest accepted task snapshot. Progress updates change\nthis value without changing `started_seq` or the row's visual position.",
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "kind": {
          "$ref": "#/$defs/RuntimeTaskKind"
        },
        "status": {
          "$ref": "#/$defs/RuntimeTaskStatus"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "backgrounded": {
          "type": "boolean",
          "default": false
        },
        "last_tool_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ]
        },
        "stats": {
          "$ref": "#/$defs/RuntimeTaskStats",
          "default": {}
        },
        "capabilities": {
          "$ref": "#/$defs/RuntimeTaskCapabilities",
          "default": {
            "stop": false,
            "background": false
          }
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "thread_id",
        "origin_turn_id",
        "kind",
        "status",
        "title",
        "started_at",
        "updated_at"
      ]
    },
    "RuntimeTaskKind": {
      "description": "A durable unit of work started by the provider while handling a thread.\n\nProviders expose different names for these (subagent, task, background\ncommand, monitor). Kybern preserves the provider type while normalizing the\nlifecycle so every client can render the same activity surface.",
      "type": "string",
      "enum": [
        "agent",
        "process",
        "monitor"
      ]
    },
    "RuntimeTaskStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "waiting",
        "stopping",
        "completed",
        "failed",
        "stopped",
        "interrupted"
      ]
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ]
    },
    "RuntimeTaskStats": {
      "type": "object",
      "properties": {
        "token_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "tool_uses": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "cpu_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "rss_kb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "RuntimeTaskCapabilities": {
      "type": "object",
      "properties": {
        "stop": {
          "description": "The provider exposes a targeted stop operation for this task.",
          "type": "boolean",
          "default": false
        },
        "background": {
          "description": "The provider can detach this foreground task without interrupting it.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "AsyncQuestionRequest": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AsyncQuestion"
          }
        }
      },
      "required": [
        "id",
        "questions"
      ]
    },
    "AsyncQuestion": {
      "description": "A provider question that does not pause the running turn.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": [
        "title"
      ]
    },
    "ApprovalRequest": {
      "description": "A pending or resolved request for the user to approve a tool call.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "tool_call_id": {
          "description": "Provider's tool-call id, when the provider exposes one.",
          "type": [
            "string",
            "null"
          ]
        },
        "tool_name": {
          "type": "string"
        },
        "input": {
          "description": "Provider-native input, rendered by the client (command, file path, diff, ...)."
        },
        "summary": {
          "description": "Human-readable one-line summary, e.g. `bash: git status`.",
          "type": "string"
        },
        "suggestions": {
          "description": "Provider-suggested \"always allow\" rules the client may offer.",
          "type": "array",
          "items": true,
          "default": []
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "thread_id",
        "turn_id",
        "tool_name",
        "input",
        "summary",
        "created_at"
      ]
    },
    "ApprovalDecision": {
      "oneOf": [
        {
          "description": "Answer a structured question or form using the provider-native payload.",
          "type": "object",
          "properties": {
            "response": true,
            "decision": {
              "type": "string",
              "const": "submit"
            }
          },
          "required": [
            "decision",
            "response"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "allow_once"
            }
          },
          "required": [
            "decision"
          ]
        },
        {
          "description": "Allow and, where the provider supports it, remember for the session.",
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "allow_always"
            }
          },
          "required": [
            "decision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "decision": {
              "type": "string",
              "const": "deny"
            }
          },
          "required": [
            "decision"
          ]
        }
      ]
    },
    "StopReason": {
      "type": "string",
      "enum": [
        "completed",
        "interrupted",
        "max_turns",
        "error"
      ]
    },
    "ProviderCommand": {
      "description": "A command advertised by a live harness's native protocol.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "description"
      ]
    },
    "ProviderUsage": {
      "description": "Authoritative context occupancy, distinct from cumulative billable tokens.",
      "type": "object",
      "properties": {
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContextUsage"
            },
            {
              "type": "null"
            }
          ]
        },
        "limits": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/UsageLimit"
          }
        }
      }
    },
    "ContextUsage": {
      "type": "object",
      "properties": {
        "used_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "window_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "used_tokens",
        "window_tokens"
      ]
    },
    "UsageLimit": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "used_percent": {
          "type": "number",
          "format": "double"
        },
        "window_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "resets_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        }
      },
      "required": [
        "name",
        "used_percent"
      ]
    },
    "NoticeLevel": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "Checkpoint": {
      "description": "Git snapshots bracketing one turn. `after` is absent while the turn runs.",
      "type": "object",
      "properties": {
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "before": {
          "description": "Commit hash of the working tree before the turn started.",
          "type": "string"
        },
        "after": {
          "description": "Commit hash after the turn ended.",
          "type": [
            "string",
            "null"
          ]
        },
        "provider_turn_id": {
          "description": "Provider-side id of this turn, for conversation rewind.",
          "type": [
            "string",
            "null"
          ]
        },
        "provider_turn_end": {
          "description": "Provider-side id of the last entry of this turn, for conversation rewind.",
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "thread_id",
        "turn_id",
        "before",
        "created_at"
      ]
    }
  }
}
