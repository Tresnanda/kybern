          "type": "string"
        },
        "delivery": {
          "description": "Requested delivery.",
          "$ref": "#/$defs/ThreadMessageDelivery"
        },
        "state": {
          "$ref": "#/$defs/ThreadMessageState"
        },
        "held_reason": {
          "type": [
            "string",
            "null"
          ]
        },
