---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(ThreadEvent)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadEvent",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "format": "int64"
    },
    "thread_id": {
      "type": "string",
      "format": "uuid"
    },
    "turn_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "seq",
    "thread_id",
    "at"
  ],
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "thread": {
          "$ref": "#/$defs/Thread"
        },
        "kind": {
          "type": "string",
          "const": "thread_created"
        }
      },
      "required": [
        "kind",
        "thread"
      ]
    },
    {
      "description": "Title, model, permission mode, pin, status or session changed.",
      "type": "object",
      "properties": {
        "thread": {
          "$ref": "#/$defs/Thread"
        },
        "kind": {
          "type": "string",
          "const": "thread_updated"
        }
      },
      "required": [
        "kind",
        "thread"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "thread_archived"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "description": "Worktree metadata stays on the thread; this ref retains the recoverable source.",
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "recovery_commit": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "worktree_cleaned"
        }
      },
      "required": [
        "kind",
        "branch",
        "recovery_commit"
      ]
    },
    {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "worktree_restored"
        }
      },
      "required": [
        "kind",
        "branch"
      ]
    },
    {
      "description": "A saved native conversation was adopted without replaying its tools.",
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/ProviderKind"
        },
        "session_id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "session_imported"
        }
      },
      "required": [
        "kind",
        "provider",
        "session_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message": {
          "$ref": "#/$defs/QueuedMessage"
        },
        "kind": {
          "type": "string",
          "const": "message_queued"
        }
      },
      "required": [
        "kind",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "const": "message_removed"
        }
      },
      "required": [
        "kind",
        "message_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message": {
          "$ref": "#/$defs/QueuedMessage"
        },
        "kind": {
          "type": "string",
          "const": "message_queue_updated"
        }
      },
      "required": [
        "kind",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message": {
          "$ref": "#/$defs/SubagentMessage"
        },
        "kind": {
          "type": "string",
          "const": "subagent_message_updated"
        }
      },
      "required": [
        "kind",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "message": {
          "$ref": "#/$defs/UserMessage"
        },
        "kind": {
          "type": "string",
          "const": "message_steered"
        }
      },
      "required": [
        "kind",
        "message_id",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "notes": {
          "$ref": "#/$defs/ThreadNotes"
        },
        "kind": {
          "type": "string",
          "const": "thread_notes_updated"
        }
      },
      "required": [
        "kind",
        "notes"
      ]
    },
    {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "coordinator_thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "const": "project_coordinator_deleted"
        }
      },
      "required": [
        "kind",
        "project_id",
        "coordinator_thread_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "group": {
          "$ref": "#/$defs/CollaborationGroup"
        },
        "kind": {
          "type": "string",
          "const": "collaboration_group_updated"
        }
      },
      "required": [
        "kind",
        "group"
      ]
    },
    {
      "type": "object",
      "properties": {
        "member": {
          "$ref": "#/$defs/GroupMember"
        },
        "kind": {
          "type": "string",
          "const": "collaboration_member_updated"
        }
      },
      "required": [
        "kind",
        "member"
      ]
    },
    {
      "type": "object",
      "properties": {
        "assignment": {
          "$ref": "#/$defs/CollaborationAssignment"
        },
        "kind": {
          "type": "string",
          "const": "collaboration_assignment_updated"
        }
      },
      "required": [
        "kind",
        "assignment"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message": {
          "$ref": "#/$defs/CollaborationMessage"
        },
        "kind": {
          "type": "string",
          "const": "collaboration_message_updated"
        }
      },
      "required": [
        "kind",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "entry": {
          "$ref": "#/$defs/ContextEntry"
        },
        "kind": {
          "type": "string",
          "const": "collaboration_context_updated"
        }
      },
      "required": [
        "kind",
        "entry"
      ]
    },
    {
      "description": "A message another thread sent this one is waiting for the user to\ndeliver or dismiss. Emitted on the recipient thread.",
      "type": "object",
      "properties": {
        "message": {
          "$ref": "#/$defs/ThreadMessageRecord"
        },
        "kind": {
          "type": "string",
          "const": "thread_message_held"
        }
      },
      "required": [
        "kind",
        "message"
      ]
    },
    {
      "description": "A held message was delivered or dismissed. Emitted on the recipient thread.",
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "resolution": {
          "$ref": "#/$defs/HeldResolution"
        },
        "kind": {
          "type": "string",
          "const": "thread_message_resolved"
        }
      },
      "required": [
        "kind",
        "message_id",
        "resolution"
      ]
    },
    {
      "description": "A thread message changed state after it was created (queued, steered,\ndelivered, answered, dismissed or failed). Emitted on the sender's\nthread (when it has one) and on the recipient's.",
      "type": "object",
      "properties": {
        "message": {
          "$ref": "#/$defs/ThreadMessageRecord"
        },
        "kind": {
          "type": "string",
          "const": "thread_message_updated"
        }
      },
      "required": [
        "kind",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "message": {
          "$ref": "#/$defs/UserMessage"
        },
        "kind": {
          "type": "string",
          "const": "turn_started"
        }
      },
      "required": [
        "kind",
        "message_id",
        "message"
      ]
    },
    {
      "description": "Native provider output resumed a settled turn without a new user message.\nIts next completion replaces the summary with cumulative accounting.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "turn_resumed"
        }
      },
      "required": [
        "kind"
      ]
    },
    {
      "description": "Provider assigned or confirmed its own session id.",
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "const": "provider_session_bound"
        }
      },
      "required": [
        "kind",
        "session_id"
      ]
    },
    {
      "description": "The daemon closed the agent process while the thread was idle. The\nnext message resumes the provider session; nothing is lost.",
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/SessionReleaseReason"
        },
        "kind": {
          "type": "string",
          "const": "provider_session_released"
        }
      },
      "required": [
        "kind",
        "reason"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin",
          "default": {
            "kind": "root"
          }
        },
        "delta": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "assistant_text_delta"
        }
      },
      "required": [
        "kind",
        "message_id",
        "delta"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin"
        },
        "source": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "image_received"
        }
      },
      "required": [
        "kind",
        "id",
        "origin",
        "source"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin",
          "default": {
            "kind": "root"
          }
        },
        "delta": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "assistant_thinking_delta"
        }
      },
      "required": [
        "kind",
        "message_id",
        "delta"
      ]
    },
    {
      "description": "The provider closed the reasoning it was streaming into this message.\nThe message itself may continue with text or tool calls.",
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin",
          "default": {
            "kind": "root"
          }
        },
        "kind": {
          "type": "string",
          "const": "assistant_thinking_completed"
        }
      },
      "required": [
        "kind",
        "message_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin",
          "default": {
            "kind": "root"
          }
        },
        "text": {
          "type": "string"
        },
        "thinking": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "const": "assistant_message_completed"
        }
      },
      "required": [
        "kind",
        "message_id",
        "text"
      ]
    },
    {
      "description": "Explicit native OMP boundaries recovered without rewriting old events.",
      "type": "object",
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "session_id": {
          "type": "string"
        },
        "native_entry_id": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecoveredAssistantBlock"
          }
        },
        "terminal_message_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "const": "assistant_message_blocks_recovered"
        }
      },
      "required": [
        "kind",
        "message_id",
        "session_id",
        "native_entry_id",
        "blocks",
        "terminal_message_id"
      ]
    },
    {
      "type": "object",
      "properties": {
        "visual": {
          "$ref": "#/$defs/HtmlVisual"
        },
        "kind": {
          "type": "string",
          "const": "html_published"
        }
      },
      "required": [
        "kind",
        "visual"
      ]
    },
    {
      "type": "object",
      "properties": {
        "call": {
          "$ref": "#/$defs/ToolCall"
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin",
          "default": {
            "kind": "root"
          }
        },
        "kind": {
          "type": "string",
          "const": "tool_call_started"
        }
      },
      "required": [
        "kind",
        "call"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tool_call_id": {
          "type": "string"
        },
        "delta": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "tool_call_output_delta"
        }
      },
      "required": [
        "kind",
        "tool_call_id",
        "delta"
      ]
    },
    {
      "type": "object",
      "properties": {
        "tool_call_id": {
          "type": "string"
        },
        "output": true,
        "output_omitted": {
          "description": "Transport-only marker used by opt-in compact event subscriptions.\nPersisted events always leave this false; clients fetch the exact\nresult through `threads.tool_output` when it is true.",
          "type": "boolean"
        },
        "stream_recoverable": {
          "description": "Transport-only capability marker for exact output-delta recovery.\nDurable events leave this false; compact subscriptions set it when\nthe matching sequence-bounded RPC is available.",
          "type": "boolean"
        },
        "is_error": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "const": "tool_call_completed"
        }
      },
      "required": [
        "kind",
        "tool_call_id",
        "output",
        "is_error"
      ]
    },
    {
      "description": "A provider-owned subagent, process, or monitor became visible.",
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/RuntimeTask"
        },
        "kind": {
          "type": "string",
          "const": "runtime_task_started"
        }
      },
      "required": [
        "kind",
        "task"
      ]
    },
    {
      "description": "Full latest-state snapshot for an existing provider-owned task.",
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/RuntimeTask"
        },
        "kind": {
          "type": "string",
          "const": "runtime_task_updated"
        }
      },
      "required": [
        "kind",
        "task"
      ]
    },
    {
      "description": "Terminal snapshot retained in the event log for history and recovery.",
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/RuntimeTask"
        },
        "kind": {
          "type": "string",
          "const": "runtime_task_completed"
        }
      },
      "required": [
        "kind",
        "task"
      ]
    },
    {
      "type": "object",
      "properties": {
        "request": {
          "$ref": "#/$defs/AsyncQuestionRequest"
        },
        "kind": {
          "type": "string",
          "const": "async_questions_requested"
        }
      },
      "required": [
        "kind",
        "request"
      ]
    },
    {
      "type": "object",
      "properties": {
        "request_id": {
          "type": "string"
        },
        "answers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "message": {
          "$ref": "#/$defs/UserMessage"
        },
        "kind": {
          "type": "string",
          "const": "async_questions_answered"
        }
      },
      "required": [
        "kind",
        "request_id",
        "answers",
        "message_id",
        "message"
      ]
    },
    {
      "type": "object",
      "properties": {
        "approval": {
          "$ref": "#/$defs/ApprovalRequest"
        },
        "kind": {
          "type": "string",
          "const": "user_input_requested"
        }
      },
      "required": [
        "kind",
        "approval"
      ]
    },
    {
      "type": "object",
      "properties": {
        "approval": {
          "$ref": "#/$defs/ApprovalRequest"
        },
        "kind": {
          "type": "string",
          "const": "approval_requested"
        }
      },
      "required": [
        "kind",
        "approval"
      ]
    },
    {
      "type": "object",
      "properties": {
        "approval_id": {
          "type": "string",
          "format": "uuid"
        },
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        },
        "kind": {
          "type": "string",
          "const": "approval_resolved"
        }
      },
      "required": [
        "kind",
        "approval_id",
        "decision"
      ]
    },
    {
      "type": "object",
      "properties": {
        "stop_reason": {
          "$ref": "#/$defs/StopReason"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "terminal_message_id": {
          "description": "Durable identity of the terminal non-empty root assistant message.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "kind": {
          "type": "string",
          "const": "turn_completed"
        }
      },
      "required": [
        "kind",
        "stop_reason",
        "usage",
        "duration_ms"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "turn_failed"
        }
      },
      "required": [
        "kind",
        "error"
      ]
    },
    {
      "type": "object",
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderCommand"
          }
        },
        "kind": {
          "type": "string",
          "const": "provider_commands_updated"
        }
      },
      "required": [
        "kind",
        "commands"
      ]
    },
    {
      "description": "A same-thread native account/harness transition. Context telemetry and\ncommands from the outgoing session no longer describe the new session.",
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/ProviderInstance"
        },
        "to": {
          "$ref": "#/$defs/ProviderInstance"
        },
        "native_resume": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "session_transitioned"
        }
      },
      "required": [
        "kind",
        "from",
        "to",
        "native_resume",
        "text"
      ]
    },
    {
      "type": "object",
      "properties": {
        "usage": {
          "$ref": "#/$defs/ProviderUsage"
        },
        "kind": {
          "type": "string",
          "const": "provider_usage_updated"
        }
      },
      "required": [
        "kind",
        "usage"
      ]
    },
    {
      "description": "Provider emitted an informational notice (compaction, status, warnings).",
      "type": "object",
      "properties": {
        "level": {
          "$ref": "#/$defs/NoticeLevel"
        },
        "text": {
          "type": "string"
        },
        "data": true,
        "kind": {
          "type": "string",
          "const": "provider_notice"
        }
      },
      "required": [
        "kind",
        "level",
        "text"
      ]
    },
    {
      "description": "A git checkpoint was taken or completed for this turn.",
      "type": "object",
      "properties": {
        "checkpoint": {
          "$ref": "#/$defs/Checkpoint"
        },
        "kind": {
          "type": "string",
          "const": "checkpoint_updated"
        }
      },
      "required": [
        "kind",
        "checkpoint"
      ]
    },
    {
      "description": "The working tree was reset to the state before `turn_id`.",
      "type": "object",
      "properties": {
        "to_turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "commit": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "workspace_reverted"
        }
      },
      "required": [
        "kind",
        "to_turn_id",
        "commit"
      ]
    }
  ],
  "$defs": {
    "Thread": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ProviderInstance"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "permission_mode": {
          "$ref": "#/$defs/PermissionMode"
        },
        "status": {
          "$ref": "#/$defs/ThreadStatus"
        },
        "worktree": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorktreeInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "cwd": {
          "description": "Working directory the agent runs in: the worktree path or the project path.",
          "type": "string"
        },
        "provider_session_id": {
          "description": "The provider's own session id once bound, used for resume and fork.",
          "type": [
            "string",
            "null"
          ]
        },
        "pinned": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "last_seq": {
          "description": "Sequence of the last event on this thread. Clients use it to detect gaps.",
          "type": "integer",
          "format": "int64"
        },
        "parent_thread_id": {
          "description": "Immutable parent for a Kybern-managed helper thread.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "coordinator_project_id": {
          "description": "Set when this thread is the persistent coordinator for a project.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "collaboration_group_id": {
          "description": "Active collaboration membership, denormalized for efficient navigation.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "subagent": {
          "description": "Set when this thread mirrors one provider-native subagent. Such a thread\nis read-only: it records what the subagent said and did, and its\n`parent_thread_id` is the thread (or subagent thread) that launched it.\nClients that do not know about subagent threads must hide them from\nthread lists.",
          "anyOf": [
            {
              "$ref": "#/$defs/SubagentInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "delegation": {
          "description": "Set when this thread is a child another thread delegated work to with\n`kybern_agent_delegate`. Unlike `subagent` it is a normal, writable\nthread; `parent_thread_id` is the delegating thread. Clients that do\nnot know about delegation hide such threads from thread lists the same\nway they hide subagents.",
          "anyOf": [
            {
              "$ref": "#/$defs/DelegationInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "project_id",
        "title",
        "provider",
        "permission_mode",
        "status",
        "cwd",
        "pinned",
        "created_at",
        "updated_at",
        "last_seq"
      ]
    },
    "ProviderInstance": {
      "description": "A configured account/instance of a provider. `default` is created implicitly.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "instance": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "instance"
      ]
    },
    "ProviderKind": {
      "description": "Coding agent backends the daemon can drive. Each has its own native driver.",
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "opencode",
        "pi",
        "omp",
        "cursor"
      ]
    },
    "PermissionMode": {
      "description": "The four permission modes.",
      "oneOf": [
        {
          "description": "Every tool call that mutates or executes asks for approval.",
          "type": "string",
          "const": "supervised"
        },
        {
          "description": "File edits proceed; shell and network still ask.",
          "type": "string",
          "const": "accept-edits"
        },
        {
          "description": "The provider decides with its own safety heuristics; asks only when unsure.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "Nothing asks. Sandboxing is the provider's problem.",
          "type": "string",
          "const": "full-access"
        }
      ]
    },
    "ThreadStatus": {
      "type": "string",
      "enum": [
        "idle",
        "running",
        "awaiting-approval",
        "failed",
        "archived"
      ]
    },
    "WorktreeInfo": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "branch"
      ]
    },
    "SubagentInfo": {
      "description": "Provider-native subagent metadata carried by a read-only child [`Thread`].\n\nThe title, model and effort live on the thread itself. This struct holds\nthe rest of what a subagent page needs and is refreshed (through\n`thread_updated`) whenever the parent's runtime task for it changes.",
      "type": "object",
      "properties": {
        "task_id": {
          "description": "Provider-stable id of the runtime task in the parent thread. Together\nwith the root thread it identifies this child thread.",
          "type": "string"
        },
        "root_thread_id": {
          "description": "The thread that owns the provider session. For a subagent launched by\nanother subagent this is the root, not `Thread::parent_thread_id`.\n`tasks.stop` and `tasks.background` accept the child thread id and\nresolve the session through it.",
          "type": "string",
          "format": "uuid"
        },
        "parent_turn_id": {
          "description": "Turn of the root thread that launched the subagent.",
          "type": "string",
          "format": "uuid"
        },
        "tool_call_id": {
          "description": "Tool call in the parent that launched it, when the provider has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "provider_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_type": {
          "description": "Provider agent type or role (`Explore`, `worker`, `task:general`).",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/RuntimeTaskStatus"
        },
        "backgrounded": {
          "type": "boolean",
          "default": false
        },
        "last_tool_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "description": "Latest progress or final result summary from the provider, as reported\n(see `progress` and `result` for the normalized one-line forms).",
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "description": "One live line while the subagent works: the provider's latest activity\ntext, else the last tool it used (`Using Read`). Cleared once it settles.",
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "description": "First line of the subagent's final answer once it settled (its last\nmessage, else the provider's result summary, else the failure message).",
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ]
        },
        "stats": {
          "$ref": "#/$defs/RuntimeTaskStats",
          "default": {}
        },
        "capabilities": {
          "description": "Whether `tasks.stop` / `tasks.background` currently work for it.",
          "$ref": "#/$defs/RuntimeTaskCapabilities",
          "default": {
            "stop": false,
            "background": false
          }
        },
        "transcript": {
          "description": "False when the harness only reports lifecycle (Pi/OMP and providers\nwithout native subagent forwarding): the transcript holds just the\nprompt and the outcome.",
          "type": "boolean",
          "default": false
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "task_id",
        "root_thread_id",
        "parent_turn_id",
        "status",
        "started_at"
      ]
    },
    "RuntimeTaskStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "waiting",
        "stopping",
        "completed",
        "failed",
        "stopped",
        "interrupted"
      ]
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ]
    },
    "RuntimeTaskStats": {
      "type": "object",
      "properties": {
        "token_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "tool_uses": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "cpu_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "rss_kb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "RuntimeTaskCapabilities": {
      "type": "object",
      "properties": {
        "stop": {
          "description": "The provider exposes a targeted stop operation for this task.",
          "type": "boolean",
          "default": false
        },
        "background": {
          "description": "The provider can detach this foreground task without interrupting it.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "DelegationInfo": {
      "description": "Delegation metadata carried by a child [`Thread`] created with\n`kybern_agent_delegate`. Refreshed through `thread_updated`.",
      "type": "object",
      "properties": {
        "task_id": {
          "description": "Stable id agents use to refer to this delegation.",
          "type": "string",
          "format": "uuid"
        },
        "operation_id": {
          "description": "Idempotency key of the delegate call.",
          "type": "string",
          "format": "uuid"
        },
        "parent_thread_id": {
          "description": "Duplicate of `Thread::parent_thread_id` for convenience.",
          "type": "string",
          "format": "uuid"
        },
        "depth": {
          "description": "1 for a direct child of a top-level thread.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "role": {
          "$ref": "#/$defs/DelegationRole",
          "default": "general"
        },
        "workspace": {
          "$ref": "#/$defs/DelegationWorkspace",
          "default": "shared"
        },
        "owns": {
          "description": "Globs relative to the checkout root this child owns (shared only).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/DelegationStatus"
        },
        "result": {
          "description": "The child's final assistant text of the completing turn (at most\n16 KiB, truncated with a marker).",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "files_touched": {
          "description": "Repo-relative paths the child edited, deduplicated, at most 200.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DelegationConflict"
          }
        },
        "base_commit": {
          "description": "Worktree: the snapshot commit the worktree was seeded from.",
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "description": "Worktree: `kybern/<child-id>`.",
          "type": [
            "string",
            "null"
          ]
        },
        "head_commit": {
          "description": "Worktree: HEAD when the child completed.",
          "type": [
            "string",
            "null"
          ]
        },
        "diffstat": {
          "description": "Worktree: `base_commit..head_commit`.",
          "anyOf": [
            {
              "$ref": "#/$defs/DiffStat"
            },
            {
              "type": "null"
            }
          ]
        },
        "worktree_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorktreeState"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "parent_notified": {
          "description": "Whether the delegating parent has been handed this outcome (delivered,\nsteered or queued). Cleared when the delegation reaches a terminal state\nand set once its `AgentResultItem` is out, so a restart can re-send an\noutcome that was still waiting in the debounce window. Rows written\nbefore this field existed read as `true`: nothing is re-sent.",
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "task_id",
        "operation_id",
        "parent_thread_id",
        "depth",
        "status",
        "started_at"
      ]
    },
    "DelegationRole": {
      "description": "What the delegating agent asked this child to be.",
      "type": "string",
      "enum": [
        "implementation",
        "research",
        "review",
        "design",
        "test",
        "general"
      ]
    },
    "DelegationWorkspace": {
      "description": "Where a delegated child works.",
      "oneOf": [
        {
          "description": "The parent's checkout and branch.",
          "type": "string",
          "const": "shared"
        },
        {
          "description": "Its own git worktree on `kybern/<child-id>`, seeded from the parent's\ncurrent uncommitted state.",
          "type": "string",
          "const": "worktree"
        }
      ]
    },
    "DelegationStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        {
          "description": "Cut off by a daemon restart.",
          "type": "string",
          "const": "interrupted"
        }
      ]
    },
    "DelegationConflict": {
      "description": "A shared-checkout edit that landed on a path a sibling delegation owns.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Repo-relative path that was edited.",
          "type": "string"
        },
        "owner_thread_id": {
          "description": "The sibling thread whose `owns` globs cover `path`.",
          "type": "string",
          "format": "uuid"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "path",
        "owner_thread_id",
        "at"
      ]
    },
    "DiffStat": {
      "description": "Files and lines changed between two commits.",
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "additions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "files",
        "additions",
        "deletions"
      ]
    },
    "WorktreeState": {
      "description": "State of a delegated child's own worktree (`DelegationWorkspace::Worktree`).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "active",
            "removed"
          ]
        },
        {
          "description": "Left on disk because it was dirty or its branch is unmerged.",
          "type": "string",
          "const": "kept"
        }
      ]
    },
    "QueuedMessage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "message": {
          "$ref": "#/$defs/UserMessage"
        }
      },
      "required": [
        "id",
        "thread_id",
        "message"
      ]
    },
    "UserMessage": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentPart"
          }
        }
      },
      "required": [
        "parts"
      ]
    },
    "ContentPart": {
      "description": "One piece of a user message.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "description": "Inline image. `data` is base64 of the raw bytes.",
          "type": "object",
          "properties": {
            "media_type": {
              "type": "string"
            },
            "data": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "required": [
            "type",
            "media_type",
            "data"
          ]
        },
        {
          "description": "Uploaded attachment served by the daemon's HTTP asset route.",
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            },
            "media_type": {
              "type": "string"
            },
            "size": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "attachment"
            }
          },
          "required": [
            "type",
            "asset_id",
            "name",
            "media_type",
            "size"
          ]
        },
        {
          "description": "`@path` mention resolved relative to the thread cwd.",
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "file_mention"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "description": "Inert reference to an existing Kybern thread. Selecting or rendering it\nnever reads, wakes, or sends to the referenced thread.",
          "type": "object",
          "properties": {
            "thread_id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string"
            },
            "project_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "type": {
              "type": "string",
              "const": "thread_reference"
            }
          },
          "required": [
            "type",
            "thread_id",
            "title"
          ]
        },
        {
          "description": "A user-selected agent skill. Drivers translate this into the provider's\nnative invocation syntax instead of treating a lookalike `$NAME` as a\nskill accidentally.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "description": "Canonical `SKILL.md` path returned by the provider catalog. Codex\nrequires it for its structured `skill` turn input; other drivers\nmay use only the name.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "skill"
            }
          },
          "required": [
            "type",
            "name",
            "path"
          ]
        },
        {
          "description": "A provider plugin or app the user pulled in with `@name`, such as\nCodex's Computer Use. `path` is the provider's own id for it\n(`plugin://name@marketplace` or `app://connector-id`); drivers without\na structured form send the mention as text.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "display_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "mention"
            }
          },
          "required": [
            "type",
            "name",
            "path"
          ]
        },
        {
          "description": "A message from another thread (or from Kybern itself when\n`from_thread_id` is `None`). Providers receive it as flattened text; see\n[`thread_message_text`].",
          "type": "object",
          "properties": {
            "message_id": {
              "description": "The `thread_messages` row id; also the queued or steered message id.",
              "type": "string",
              "format": "uuid"
            },
            "from_thread_id": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "from_title": {
              "type": "string"
            },
            "purpose": {
              "$ref": "#/$defs/ThreadMessagePurpose"
            },
            "reply_to": {
              "type": [
                "string",
                "null"
              ],
              "format": "uuid"
            },
            "body": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "thread_message"
            }
          },
          "required": [
            "type",
            "message_id",
            "from_title",
            "purpose",
            "body"
          ]
        },
        {
          "description": "A batch of delegated-agent outcomes delivered to the delegating thread.\nProviders receive it as flattened text; see [`agent_results_text`].",
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AgentResultItem"
              }
            },
            "type": {
              "type": "string",
              "const": "agent_results"
            }
          },
          "required": [
            "type",
            "items"
          ]
        }
      ]
    },
    "ThreadMessagePurpose": {
      "description": "Why a message exists. `Task` is a delegation brief; `Warning` comes from\nKybern itself (for example a file ownership clash).",
      "type": "string",
      "enum": [
        "task",
        "message",
        "question",
        "reply",
        "warning"
      ]
    },
    "AgentResultItem": {
      "description": "One delegated agent's outcome inside an [`ContentPart::AgentResults`] batch.",
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "format": "uuid"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/ProviderKind"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "$ref": "#/$defs/DelegationRole",
          "default": "general"
        },
        "status": {
          "$ref": "#/$defs/DelegationStatus"
        },
        "result": {
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "workspace": {
          "$ref": "#/$defs/DelegationWorkspace",
          "default": "shared"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
