        "delivery",
        "state",
        "created_at",
        "updated_at"
      ]
    },
    "ThreadMessageDelivery": {
      "description": "How the sender asked for a thread message to be delivered.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "queue"
          ]
        },
        {
          "description": "Into the recipient's running turn when its harness can steer; falls\nback to `Queue` otherwise.",
          "type": "string",
          "const": "steer"
        }
      ]
    },
    "ThreadMessageState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "queued",
            "steered",
            "dismissed",
            "failed"
          ]
        },
        {
          "description": "Blocked by the permission rule; waiting for the user to deliver or dismiss it.",
          "type": "string",
          "const": "held"
        },
        {
          "description": "The recipient's turn that consumed it has started.",
          "type": "string",
          "const": "delivered"
        },
        {
          "description": "A question that received its reply.",
          "type": "string",
          "const": "answered"
        }
      ]
    },
    "HeldResolution": {
      "description": "How a held message left the held state.",
      "type": "string",
      "enum": [
        "delivered",
        "dismissed"
      ]
    },
    "SessionReleaseReason": {
      "description": "Why the daemon closed an agent process. The thread's conversation is kept\nby the provider and resumes with the next message.",
      "oneOf": [
        {
          "description": "The user released a parked process to reconnect on the next message.",
          "type": "string",
          "const": "manual"
        },
        {
          "description": "The thread was idle for longer than `background.session_idle_minutes`.",
          "type": "string",
          "const": "idle"
        },
        {
          "description": "More idle processes were alive than `background.max_idle_sessions`.",
          "type": "string",
          "const": "capacity"
        },
        {
          "description": "The harness was closed so it could be updated.",
          "type": "string",
          "const": "update"
        },
        {
          "description": "The host is on battery and `background.save_power_on_battery` is on.",
          "type": "string",
          "const": "power"
        }
      ]
    },
    "EventOrigin": {
      "description": "Ownership of provider output after it has been normalized by a driver.\nRoot output is eligible for the parent transcript; agent-owned output is\nretained as activity metadata and must never be promoted to the root answer.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "root"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "provider_thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "agent"
            }
          },
          "required": [
            "kind",
            "task_id"
          ]
        }
      ]
    },
