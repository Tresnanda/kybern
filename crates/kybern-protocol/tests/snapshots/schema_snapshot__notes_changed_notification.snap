---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(NotesChangedNotification)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NotesChangedNotification",
  "description": "Params of the `notes.changed` notification.",
  "type": "object",
  "properties": {
    "note": {
      "description": "The note after the change, including soft deletes and restores.",
      "anyOf": [
        {
          "$ref": "#/$defs/NoteSummary"
        },
        {
          "type": "null"
        }
      ]
    },
    "purged_id": {
      "description": "Set instead of `note` when a note was permanently removed.",
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    }
  },
  "$defs": {
    "NoteSummary": {
      "description": "A note without its body, as listed.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "scope": {
          "$ref": "#/$defs/NoteScope"
        },
        "project_id": {
          "description": "The project of a project note, or the thread's project for a thread note.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "thread_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "title": {
          "description": "A thread note's title is the thread's title.",
          "type": "string"
        },
        "preview": {
          "description": "Plain-text excerpt of the body, markdown syntax removed, at most 240 characters.",
          "type": "string"
        },
        "checklist": {
          "$ref": "#/$defs/NoteChecklist"
        },
        "pinned": {
          "type": "boolean"
        },
        "revision": {
          "description": "Content revision: bumps when the title or body changes. 0 means no saved note yet.",
          "type": "integer",
          "format": "int64"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "deleted_at": {
          "description": "Set while the note is in Recently deleted.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "origin": {
          "description": "Where a deleted note came from once its project or thread was removed,\nsuch as \"kybern\" or \"kybern › Fix login\".",
          "type": [
            "string",
            "null"
          ]
        },
        "created_by_thread": {
          "description": "The thread whose agent created the note with its native tools. Absent for\nnotes the user wrote; agents may only append to those.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "project_role": {
          "description": "Set on a project's brief and setup notes (one of each per project). Only the\nuser edits the brief; only the project's Coordinator writes the setup note.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectNoteRole"
            },
            {
              "type": "null"
            }
          ]
        },
        "category": {
          "description": "The kind of memory this note holds. Absent for ordinary notes.",
          "anyOf": [
            {
              "$ref": "#/$defs/NoteCategory"
            },
            {
              "type": "null"
            }
          ]
        },
        "stale": {
          "description": "Set when a dated claim in the note cites a file that changed since the\ncommit it names. Computed by the daemon from git, never stored.",
          "anyOf": [
            {
              "$ref": "#/$defs/StaleInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "undated": {
          "description": "A project note without a category that was written before categories existed\n(see `NotesListResult::history_since`).",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "scope",
        "title",
        "preview",
        "checklist",
        "pinned",
        "revision",
        "created_at",
        "updated_at"
      ]
    },
    "NoteScope": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "global",
            "project"
          ]
        },
        {
          "description": "Exactly one per thread; titled after the thread.",
          "type": "string",
          "const": "thread"
        }
      ]
    },
    "NoteChecklist": {
      "type": "object",
      "properties": {
        "done": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "done",
        "total"
      ]
    },
    "ProjectNoteRole": {
      "description": "What a project note is for. The brief is the user's own instructions for the\nproject; the setup note records how to build, run and test it and is kept by the\nproject's Coordinator. Ordinary notes (memory) have no role.",
      "type": "string",
      "enum": [
        "brief",
        "setup"
      ]
    },
    "NoteCategory": {
      "description": "What kind of memory a project note holds. Agents file dated claims under one;\nthe Coordinator's notes index groups by it. A note without a category is\n\"Other\", or \"Undated\" when it predates categories.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "decision",
            "convention",
            "gotcha"
          ]
        },
        {
          "description": "What the user wants, in their words.",
          "type": "string",
          "const": "preference"
        }
      ]
    },
    "StaleInfo": {
      "description": "Why a note may be outdated: a claim in it cites a commit (`As of \\`abc1234\\``)\nand a file, and that file changed after the commit.",
      "type": "object",
      "properties": {
        "path": {
          "description": "The cited path that changed, as the note writes it.",
          "type": "string"
        },
        "commit": {
          "description": "Short id of the latest commit that changed it after the cited one.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "commit"
      ]
    }
  }
}
