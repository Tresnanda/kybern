---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(RemoteChild)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemoteChild",
  "description": "A delegated child that runs on another machine. The delegating machine keeps this row instead of a\nthread: the thread lives on `target`.",
  "type": "object",
  "properties": {
    "task_id": {
      "description": "The id `kybern_agent_status`, `wait` and `cancel` use, the same on both machines.",
      "type": "string",
      "format": "uuid"
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "parent_thread_id": {
      "description": "The delegating thread on this machine.",
      "type": "string",
      "format": "uuid"
    },
    "target": {
      "type": "string"
    },
    "remote_thread_id": {
      "description": "The child thread on the target, once it acknowledged.",
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "state": {
      "$ref": "#/$defs/RemoteChildState"
    },
    "stop_requested": {
      "description": "Stop was asked for and the target has not confirmed it yet.",
      "type": "boolean"
    },
    "last_seq": {
      "type": "integer",
      "format": "int64"
    },
    "title": {
      "type": "string"
    },
    "provider": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderKind"
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "info": {
      "description": "The mirror of the target's delegation (result, files touched, branch, head commit).",
      "$ref": "#/$defs/DelegationInfo"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "task_id",
    "operation_id",
    "parent_thread_id",
    "target",
    "state",
    "last_seq",
    "title",
    "info",
    "created_at",
    "updated_at"
  ],
  "$defs": {
    "RemoteChildState": {
      "description": "Where a delegation that runs on another machine stands, as the delegating machine records it.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        {
          "description": "Written before anything was sent: the target has not acknowledged yet.",
          "type": "string",
          "const": "pending"
        },
        {
          "description": "The target was removed, or no longer knows the child.",
          "type": "string",
          "const": "unreachable"
        }
      ]
    },
    "ProviderKind": {
      "description": "Coding agent backends the daemon can drive. Each has its own native driver.",
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "opencode",
        "pi",
        "omp",
        "cursor",
        "antigravity"
      ]
    },
    "DelegationInfo": {
      "description": "Delegation metadata carried by a child [`Thread`] created with\n`kybern_agent_delegate`. Refreshed through `thread_updated`.",
      "type": "object",
      "properties": {
        "task_id": {
          "description": "Stable id agents use to refer to this delegation.",
          "type": "string",
          "format": "uuid"
        },
        "operation_id": {
          "description": "Idempotency key of the delegate call.",
          "type": "string",
          "format": "uuid"
        },
        "parent_thread_id": {
          "description": "Duplicate of `Thread::parent_thread_id` for convenience.",
          "type": "string",
          "format": "uuid"
        },
        "depth": {
          "description": "1 for a direct child of a top-level thread.",
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "role": {
          "$ref": "#/$defs/DelegationRole",
          "default": "general"
        },
        "workspace": {
          "$ref": "#/$defs/DelegationWorkspace",
          "default": "shared"
        },
        "default_override": {
          "description": "Set when a Coordinator chose another harness or model than the default\nconfigured for this child's role.",
          "anyOf": [
            {
              "$ref": "#/$defs/DefaultOverride"
            },
            {
              "type": "null"
            }
          ]
        },
        "owns": {
          "description": "Globs relative to the checkout root this child owns (shared only).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/DelegationStatus"
        },
        "result": {
          "description": "The child's final assistant text of the completing turn (at most\n16 KiB, truncated with a marker).",
          "type": [
            "string",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "files_touched": {
          "description": "Repo-relative paths the child edited, deduplicated, at most 200.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DelegationConflict"
          }
        },
        "base_commit": {
          "description": "Worktree: the snapshot commit the worktree was seeded from.",
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "description": "Worktree: `kybern/<child-id>`.",
          "type": [
            "string",
            "null"
          ]
        },
        "head_commit": {
          "description": "Worktree: HEAD when the child completed.",
          "type": [
            "string",
            "null"
          ]
        },
        "diffstat": {
          "description": "Worktree: `base_commit..head_commit`.",
          "anyOf": [
            {
              "$ref": "#/$defs/DiffStat"
            },
            {
              "type": "null"
            }
          ]
        },
        "worktree_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/WorktreeState"
            },
            {
              "type": "null"
            }
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "parent_notified": {
          "description": "Whether the delegating parent has been handed this outcome (delivered,\nsteered or queued). Cleared when the delegation reaches a terminal state\nand set once its `AgentResultItem` is out, so a restart can re-send an\noutcome that was still waiting in the debounce window. Rows written\nbefore this field existed read as `true`: nothing is re-sent.",
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "task_id",
        "operation_id",
        "parent_thread_id",
        "depth",
        "status",
        "started_at"
      ]
    },
    "DelegationRole": {
      "description": "What the delegating agent asked this child to be.",
      "type": "string",
      "enum": [
        "implementation",
        "research",
        "review",
        "design",
        "test",
        "general"
      ]
    },
    "DelegationWorkspace": {
      "description": "Where a delegated child works.",
      "oneOf": [
        {
          "description": "The parent's checkout and branch.",
          "type": "string",
          "const": "shared"
        },
        {
          "description": "Its own git worktree on `kybern/<child-id>`, seeded from the parent's\ncurrent uncommitted state.",
          "type": "string",
          "const": "worktree"
        }
      ]
    },
    "DefaultOverride": {
      "description": "A Coordinator delegation that used another harness or model than the\ndefault configured for its role. `provider` and `model` are the default that\nwas set aside (the child's own are on its thread), so a client can write\n\"Claude Opus 5.5 · instead of the Sonnet default: <reason>\".",
      "type": "object",
      "properties": {
        "provider": {
          "$ref": "#/$defs/ProviderInstance"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "The Coordinator's reason, as it passed it in `override_reason`.",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "reason"
      ]
    },
    "ProviderInstance": {
      "description": "A configured account/instance of a provider. `default` is created implicitly.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "instance": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "instance"
      ]
    },
    "DelegationStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "running",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        {
          "description": "Cut off by a daemon restart.",
          "type": "string",
          "const": "interrupted"
        }
      ]
    },
    "DelegationConflict": {
      "description": "A shared-checkout edit that landed on a path a sibling delegation owns.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Repo-relative path that was edited.",
          "type": "string"
        },
        "owner_thread_id": {
          "description": "The sibling thread whose `owns` globs cover `path`.",
          "type": "string",
          "format": "uuid"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "path",
        "owner_thread_id",
        "at"
      ]
    },
    "DiffStat": {
      "description": "Files and lines changed between two commits.",
      "type": "object",
      "properties": {
        "files": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "additions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "files",
        "additions",
        "deletions"
      ]
    },
    "WorktreeState": {
      "description": "State of a delegated child's own worktree (`DelegationWorkspace::Worktree`).",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "active",
            "removed"
          ]
        },
        {
          "description": "Left on disk because it was dirty or its branch is unmerged.",
          "type": "string",
          "const": "kept"
        }
      ]
    }
  }
}
