---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(ProjectsChangedNotification)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectsChangedNotification",
  "description": "Params of the `projects.changed` notification, sent after a project is added,\nupdated or removed by any client or by the daemon itself.",
  "type": "object",
  "properties": {
    "projects": {
      "description": "Every project after the change, in `projects.list` order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Project"
      }
    }
  },
  "required": [
    "projects"
  ],
  "$defs": {
    "Project": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "description": "Absolute path on the daemon host.",
          "type": "string"
        },
        "is_git": {
          "type": "boolean"
        },
        "worktrees_default": {
          "description": "Per-project override for \"new threads use a worktree\". Global default is off.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "task_prefix": {
          "description": "Prefix for this project's task keys, such as `ADE`. Assigned from the\nproject name when it is added; editable through `projects.update`.",
          "type": [
            "string",
            "null"
          ]
        },
        "brief_in_all_threads": {
          "description": "When on, every new thread in the project also gets the project brief and an\nindex of its notes at session start (not only the Coordinator's children).",
          "type": "boolean",
          "default": false
        },
        "coordinator": {
          "description": "This project's overrides of the Coordinator settings in\n[`OrchestrationSettings`]. Absent fields fall back to the global value;\nsee [`OrchestrationSettings::effective_for`].",
          "anyOf": [
            {
              "$ref": "#/$defs/CoordinatorOverrides"
            },
            {
              "type": "null"
            }
          ]
        },
        "space_id": {
          "description": "The space this project belongs to. Absent only for free chat and on daemons without spaces.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "kind": {
          "description": "`group` for a parent folder of several git repositories. Absent means single.",
          "$ref": "#/$defs/ProjectKind"
        },
        "members": {
          "description": "Group members in order; the first is the primary (the group folder itself\nwhen it is a member, else the first member by path). Empty for single projects.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProjectMember"
          }
        },
        "worktree_copy": {
          "description": "Top-level entries of the group folder (files or folders, never a member or\n`.git`) the user chose to copy into each new worktree container, after\n`AGENTS.md`, `CLAUDE.md` and `.claude/`. Entries missing at copy time are skipped.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "instructions_offer_dismissed": {
          "description": "The user hid the \"Add shared instructions\" offer for this group.",
          "type": "boolean"
        },
        "repo": {
          "description": "What identifies this repository across machines, refreshed with Git status. Absent until\nthe first refresh and for folders that are not repositories. For a group, the primary member's.",
          "anyOf": [
            {
              "$ref": "#/$defs/RepoIdentity"
            },
            {
              "type": "null"
            }
          ]
        },
        "repos": {
          "description": "A group's members' identities, sorted. Empty for single projects.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RepoIdentity"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "is_git",
        "created_at",
        "updated_at"
      ]
    },
    "CoordinatorOverrides": {
      "description": "A project's overrides of the Coordinator settings. Absent fields fall back\nto [`OrchestrationSettings`]. `role_defaults` replaces the global entry of\neach role it lists.",
      "type": "object",
      "properties": {
        "role_defaults": {
          "type": "object",
          "properties": {
            "design": {
              "$ref": "#/$defs/RoleDefault"
            },
            "general": {
              "$ref": "#/$defs/RoleDefault"
            },
            "implementation": {
              "$ref": "#/$defs/RoleDefault"
            },
            "research": {
              "$ref": "#/$defs/RoleDefault"
            },
            "review": {
              "$ref": "#/$defs/RoleDefault"
            },
            "test": {
              "$ref": "#/$defs/RoleDefault"
            }
          },
          "additionalProperties": false
        },
        "lead_autonomy": {
          "anyOf": [
            {
              "$ref": "#/$defs/LeadAutonomy"
            },
            {
              "type": "null"
            }
          ]
        },
        "lead_workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/DelegationWorkspace"
            },
            {
              "type": "null"
            }
          ]
        },
        "lead_push_without_asking": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "lead_max_children": {
          "description": "Most delegated children the Coordinator may have running (1..=16).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "rotation_budget_tokens": {
          "description": "Context budget for this project's Coordinator (0 is off).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "RoleDefault": {
      "description": "The harness, model and effort used for one kind of delegated work. Every\nfield is optional: an unset one follows the delegating thread.",
      "type": "object",
      "properties": {
        "provider": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProviderInstance"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ProviderInstance": {
      "description": "A configured account/instance of a provider. `default` is created implicitly.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "instance": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "instance"
      ]
    },
    "ProviderKind": {
      "description": "Coding agent backends the daemon can drive. Each has its own native driver.",
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "opencode",
        "pi",
        "omp",
        "cursor"
      ]
    },
    "LeadAutonomy": {
      "description": "How freely a Coordinator acts before asking the user.",
      "oneOf": [
        {
          "description": "Acts on its own judgment and reports.",
          "type": "string",
          "const": "act"
        },
        {
          "description": "Acts on small work; proposes a plan first for anything large or risky.",
          "type": "string",
          "const": "propose_large"
        },
        {
          "description": "Proposes a plan before every piece of work.",
          "type": "string",
          "const": "propose_first"
        }
      ]
    },
    "DelegationWorkspace": {
      "description": "Where a delegated child works.",
      "oneOf": [
        {
          "description": "The parent's checkout and branch.",
          "type": "string",
          "const": "shared"
        },
        {
          "description": "Its own git worktree on `kybern/<child-id>`, seeded from the parent's\ncurrent uncommitted state.",
          "type": "string",
          "const": "worktree"
        }
      ]
    },
    "ProjectKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "single"
          ]
        },
        {
          "description": "A parent folder whose members are git repositories inside it.",
          "type": "string",
          "const": "group"
        }
      ]
    },
    "ProjectMember": {
      "description": "One git repository of a group project.",
      "type": "object",
      "properties": {
        "path": {
          "description": "'/'-separated, relative to `Project.path`; \".\" is the group folder itself.",
          "type": "string"
        },
        "name": {
          "description": "Display name: the last path component, or the group folder's name for \".\".\nTwo members with the same last component get their parent segment too (\"a/api\").",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MemberStatus"
        }
      },
      "required": [
        "path",
        "name",
        "status"
      ]
    },
    "MemberStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ok"
          ]
        },
        {
          "description": "The folder is gone (deleted or renamed).",
          "type": "string",
          "const": "missing"
        },
        {
          "description": "The folder exists but is no longer a git repository.",
          "type": "string",
          "const": "not_git"
        }
      ]
    },
    "RepoIdentity": {
      "description": "What makes two checkouts the same logical project on different machines.",
      "type": "object",
      "properties": {
        "root_commit": {
          "description": "The smallest hash in `git rev-list --max-parents=0 HEAD`.",
          "type": [
            "string",
            "null"
          ]
        },
        "remote": {
          "description": "The `origin` URL normalized to `host/owner/repo`: lowercase, no scheme, user or `.git`.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
