---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(PeerPresence)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PeerPresence",
  "description": "`peer.presence`: pushed on change and with the heartbeat.",
  "type": "object",
  "properties": {
    "update": {
      "description": "Live progress, supported by update.progress.v1.",
      "anyOf": [
        {
          "$ref": "#/$defs/DaemonUpdate"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "string"
    },
    "network_protocol": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "harnesses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HarnessSummary"
      },
      "default": []
    },
    "load": {
      "description": "1-minute load average divided by logical cores.",
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "battery": {
      "description": "Percent, absent without a battery.",
      "type": [
        "number",
        "null"
      ],
      "format": "float"
    },
    "at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "version",
    "network_protocol",
    "at"
  ],
  "$defs": {
    "DaemonUpdate": {
      "description": "The daemon's own update state. The daemon replaces its binary from the\nGitHub release feed and restarts under its service manager; persisted so\nclients see the same record after a reconnect or the restart itself.",
      "type": "object",
      "properties": {
        "update_id": {
          "description": "Identity retained across the replacement process and its reconnect.",
          "type": [
            "string",
            "null"
          ]
        },
        "target_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "download_percent": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "busy_thread": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/DaemonUpdateStatus"
        },
        "message": {
          "type": "string"
        },
        "current_version": {
          "description": "Version of the running daemon.",
          "type": "string"
        },
        "latest_version": {
          "description": "Newest published version, once a check has succeeded.",
          "type": [
            "string",
            "null"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "status",
        "message",
        "current_version"
      ]
    },
    "DaemonUpdateStatus": {
      "type": "string",
      "enum": [
        "not_checked",
        "checking",
        "current",
        "available",
        "waiting",
        "updating",
        "restarting",
        "unsupported",
        "failed"
      ]
    },
    "HarnessSummary": {
      "description": "A harness on a machine, in the short form the Machines page shows.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "available": {
          "type": "boolean"
        },
        "signed_in": {
          "description": "Absent when the daemon cannot tell.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "available"
      ]
    },
    "ProviderKind": {
      "description": "Coding agent backends the daemon can drive. Each has its own native driver.",
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "opencode",
        "pi",
        "omp",
        "cursor",
        "antigravity",
        "grok-build"
      ]
    }
  }
}
