---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(TranscriptEntry)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TranscriptEntry",
  "description": "Rendered transcript entries, projected from events by the daemon.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "seq": {
          "type": "integer",
          "format": "int64"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin"
        },
        "source": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "const": "image"
        }
      },
      "required": [
        "role",
        "id",
        "turn_id",
        "seq",
        "at",
        "origin",
        "source"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "seq": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "message": {
          "$ref": "#/$defs/UserMessage"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "role": {
          "type": "string",
          "const": "user"
        }
      },
      "required": [
        "role",
        "id",
        "turn_id",
        "message",
        "at"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "seq": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin",
          "default": {
            "kind": "root"
          }
        },
        "segment": {
          "description": "Segment index within one `message_id`. A provider can keep a single\nmessage id across a tool call (Claude streams preamble → tool →\nanswer under one id); the projection splits the text at each\nrow-making event so post-tool prose is its own entry, ordered after\nthe tool. `0` is the first/only segment. `(id, segment)` is the\nstable identity a client keys on.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "text": {
          "type": "string"
        },
        "thinking": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "complete": {
          "type": "boolean"
        },
        "role": {
          "type": "string",
          "const": "assistant"
        }
      },
      "required": [
        "role",
        "id",
        "turn_id",
        "text",
        "at",
        "complete"
      ]
    },
    {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "seq": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "origin": {
          "$ref": "#/$defs/EventOrigin",
          "default": {
            "kind": "root"
          }
        },
        "call": {
          "$ref": "#/$defs/ToolCall"
        },
        "output": true,
        "is_error": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "role": {
          "type": "string",
          "const": "tool_call"
        }
      },
      "required": [
        "role",
        "turn_id",
        "call",
        "is_error",
        "complete",
        "at"
      ]
    },
    {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "seq": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "approval": {
          "$ref": "#/$defs/ApprovalRequest"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalDecision"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "type": "string",
          "const": "approval"
        }
      },
      "required": [
        "role",
        "turn_id",
        "approval"
      ]
    },
    {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "seq": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "stop_reason": {
          "$ref": "#/$defs/StopReason"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "cost_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "duration_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "terminal_message_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": "string",
          "const": "turn_summary"
        }
      },
      "required": [
        "role",
        "turn_id",
        "stop_reason",
        "usage",
        "duration_ms",
        "at"
      ]
    },
    {
      "description": "Stable launch row for a provider-owned task. Later snapshots update the\ntask in place; `seq` remains the first event that made it visible.",
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "seq": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "task": {
          "$ref": "#/$defs/RuntimeTask"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "role": {
          "type": "string",
          "const": "runtime_task"
        }
      },
      "required": [
        "role",
        "turn_id",
        "task",
        "at"
      ]
    },
    {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "seq": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "level": {
          "$ref": "#/$defs/NoticeLevel"
        },
        "text": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "role": {
          "type": "string",
          "const": "notice"
        }
      },
      "required": [
        "role",
        "turn_id",
        "level",
        "text",
        "at"
      ]
    },
    {
      "type": "object",
      "properties": {
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "seq": {
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "commit": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "role": {
          "type": "string",
          "const": "reverted"
        }
      },
      "required": [
        "role",
        "turn_id",
        "commit",
        "at"
      ]
    }
  ],
  "$defs": {
    "EventOrigin": {
      "description": "Ownership of provider output after it has been normalized by a driver.\nRoot output is eligible for the parent transcript; agent-owned output is\nretained as activity metadata and must never be promoted to the root answer.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "root"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "provider_thread_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "agent"
            }
          },
          "required": [
            "kind",
            "task_id"
          ]
        }
      ]
    },
    "UserMessage": {
      "type": "object",
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContentPart"
          }
        }
      },
      "required": [
        "parts"
      ]
    },
    "ContentPart": {
      "description": "One piece of a user message.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "description": "Inline image. `data` is base64 of the raw bytes.",
          "type": "object",
          "properties": {
            "media_type": {
              "type": "string"
            },
            "data": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "image"
            }
          },
          "required": [
            "type",
            "media_type",
            "data"
          ]
        },
        {
          "description": "Uploaded attachment served by the daemon's HTTP asset route.",
          "type": "object",
          "properties": {
            "asset_id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            },
            "media_type": {
              "type": "string"
            },
            "size": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "attachment"
            }
          },
          "required": [
            "type",
            "asset_id",
            "name",
            "media_type",
            "size"
          ]
        },
        {
          "description": "`@path` mention resolved relative to the thread cwd.",
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "file_mention"
            }
          },
          "required": [
            "type",
            "path"
          ]
        },
        {
          "description": "A user-selected agent skill. Drivers translate this into the provider's\nnative invocation syntax instead of treating a lookalike `$NAME` as a\nskill accidentally.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "description": "Canonical `SKILL.md` path returned by the provider catalog. Codex\nrequires it for its structured `skill` turn input; other drivers\nmay use only the name.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "skill"
            }
          },
          "required": [
            "type",
            "name",
            "path"
          ]
        },
        {
          "description": "A provider plugin or app the user pulled in with `@name`, such as\nCodex's Computer Use. `path` is the provider's own id for it\n(`plugin://name@marketplace` or `app://connector-id`); drivers without\na structured form send the mention as text.",
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "display_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "mention"
            }
          },
          "required": [
            "type",
            "name",
            "path"
          ]
        }
      ]
    },
    "ToolCall": {
      "description": "A tool invocation as shown in the transcript.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "input": true,
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "input"
      ]
    },
    "ApprovalRequest": {
      "description": "A pending or resolved request for the user to approve a tool call.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "turn_id": {
          "type": "string",
          "format": "uuid"
        },
        "tool_call_id": {
          "description": "Provider's tool-call id, when the provider exposes one.",
          "type": [
            "string",
            "null"
          ]
        },
        "tool_name": {
          "type": "string"
        },
        "input": {
          "description": "Provider-native input, rendered by the client (command, file path, diff, ...)."
        },
        "summary": {
          "description": "Human-readable one-line summary, e.g. `bash: git status`.",
          "type": "string"
        },
        "suggestions": {
          "description": "Provider-suggested \"always allow\" rules the client may offer.",
          "type": "array",
          "items": true,
          "default": []
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "thread_id",
        "turn_id",
        "tool_name",
        "input",
        "summary",
        "created_at"
      ]
    },
    "ApprovalDecision": {
      "oneOf": [
        {
          "description": "Answer a structured question or form using the provider-native payload.",
          "type": "object",
          "properties": {
            "response": true,
            "decision": {
              "type": "string",
              "const": "submit"
            }
          },
          "required": [
            "decision",
            "response"
          ]
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "allow_once"
            }
          },
          "required": [
            "decision"
          ]
        },
        {
          "description": "Allow and, where the provider supports it, remember for the session.",
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "allow_always"
            }
          },
          "required": [
            "decision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "decision": {
              "type": "string",
              "const": "deny"
            }
          },
          "required": [
            "decision"
          ]
        }
      ]
    },
    "StopReason": {
      "type": "string",
      "enum": [
        "completed",
        "interrupted",
        "max_turns",
        "error"
      ]
    },
    "Usage": {
      "type": "object",
      "properties": {
        "input_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "cache_read_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        },
        "cache_write_tokens": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "default": 0
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ]
    },
    "RuntimeTask": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Provider-stable task, child-thread, tool-call, or process id.",
          "type": "string"
        },
        "thread_id": {
          "type": "string",
          "format": "uuid"
        },
        "origin_turn_id": {
          "description": "Kybern turn that launched this task. Background work can outlive it.",
          "type": "string",
          "format": "uuid"
        },
        "started_seq": {
          "description": "Event sequence that first anchored this task in the transcript. Older\nstored payloads use zero and are repaired by the event projector.",
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "updated_seq": {
          "description": "Sequence of the latest accepted task snapshot. Progress updates change\nthis value without changing `started_seq` or the row's visual position.",
          "type": "integer",
          "format": "int64",
          "default": 0
        },
        "kind": {
          "$ref": "#/$defs/RuntimeTaskKind"
        },
        "status": {
          "$ref": "#/$defs/RuntimeTaskStatus"
        },
        "title": {
          "type": "string"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tool_call_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "provider_thread_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "backgrounded": {
          "type": "boolean",
          "default": false
        },
        "last_tool_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ]
        },
        "stats": {
          "$ref": "#/$defs/RuntimeTaskStats",
          "default": {}
        },
        "capabilities": {
          "$ref": "#/$defs/RuntimeTaskCapabilities",
          "default": {
            "stop": false,
            "background": false
          }
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "thread_id",
        "origin_turn_id",
        "kind",
        "status",
        "title",
        "started_at",
        "updated_at"
      ]
    },
    "RuntimeTaskKind": {
      "description": "A durable unit of work started by the provider while handling a thread.\n\nProviders expose different names for these (subagent, task, background\ncommand, monitor). Kybern preserves the provider type while normalizing the\nlifecycle so every client can render the same activity surface.",
      "type": "string",
      "enum": [
        "agent",
        "process",
        "monitor"
      ]
    },
    "RuntimeTaskStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "waiting",
        "stopping",
        "completed",
        "failed",
        "stopped",
        "interrupted"
      ]
    },
    "RuntimeTaskStats": {
      "type": "object",
      "properties": {
        "token_count": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "tool_uses": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "duration_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "cpu_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "rss_kb": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      }
    },
    "RuntimeTaskCapabilities": {
      "type": "object",
      "properties": {
        "stop": {
          "description": "The provider exposes a targeted stop operation for this task.",
          "type": "boolean",
          "default": false
        },
        "background": {
          "description": "The provider can detach this foreground task without interrupting it.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "NoticeLevel": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    }
  }
}
