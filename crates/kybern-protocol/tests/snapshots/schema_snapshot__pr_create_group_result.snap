---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(PrCreateGroupResult)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrCreateGroupResult",
  "type": "object",
  "properties": {
    "pull_requests": {
      "description": "Created pull requests, in project order.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RepoPullRequest"
      }
    },
    "skipped": {
      "description": "Members without a pull request: `path` is the member, `reason` a sentence\nsuch as \"No GitHub remote\", \"No changes\" or the error.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/RejectedFolder"
      }
    }
  },
  "required": [
    "pull_requests"
  ],
  "$defs": {
    "RepoPullRequest": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string"
        },
        "pull_request": {
          "$ref": "#/$defs/PullRequest"
        }
      },
      "required": [
        "repo",
        "pull_request"
      ]
    },
    "PullRequest": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "is_draft": {
          "type": "boolean"
        },
        "author": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "author_avatar_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "author_is_bot": {
          "type": "boolean"
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "additions": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "deletions": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "review_decision": {
          "description": "APPROVED | CHANGES_REQUESTED | REVIEW_REQUIRED",
          "type": [
            "string",
            "null"
          ]
        },
        "mergeable": {
          "description": "MERGEABLE | CONFLICTING | UNKNOWN",
          "type": [
            "string",
            "null"
          ]
        },
        "merge_state_status": {
          "description": "CLEAN | BLOCKED | BEHIND | DIRTY | UNSTABLE | DRAFT | HAS_HOOKS | UNKNOWN.\nLists carry it so rows group by readiness without a detail fetch per row.",
          "type": [
            "string",
            "null"
          ]
        },
        "auto_merge": {
          "description": "Auto-merge is armed on this pull request.",
          "anyOf": [
            {
              "$ref": "#/$defs/PrAutoMerge"
            },
            {
              "type": "null"
            }
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PrLabel"
          }
        },
        "checks_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrChecksSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "repo": {
          "description": "Group projects: the member repository (path relative to the group folder)\nthis pull request belongs to. None for single-repository projects.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "number",
        "title",
        "url",
        "state",
        "head",
        "base",
        "is_draft",
        "author",
        "updated_at"
      ]
    },
    "PrAutoMerge": {
      "description": "GitHub auto-merge: the pull request merges itself once its requirements pass.",
      "type": "object",
      "properties": {
        "enabled_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "merge_method": {
          "description": "squash | merge | rebase",
          "type": "string"
        }
      },
      "required": [
        "merge_method"
      ]
    },
    "PrLabel": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "color": {
          "description": "Hex without '#', as GitHub returns it.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "color"
      ]
    },
    "PrChecksSummary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "total",
        "passed",
        "failed",
        "pending",
        "skipped"
      ]
    },
    "RejectedFolder": {
      "description": "A folder that can't be a member, or a repository skipped by an operation,\nwith a user-facing sentence.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "reason"
      ]
    }
  }
}
