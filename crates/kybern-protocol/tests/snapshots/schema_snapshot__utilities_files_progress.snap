{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FilesProgress",
  "description": "Pushed to the sender's clients while a send runs.",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "format": "uuid"
    },
    "sent": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "total": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    }
  },
  "required": [
    "item_id",
    "sent",
    "total"
  ]
}
