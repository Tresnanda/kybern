---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(FilesSendParams)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FilesSendParams",
  "description": "`files.send`: queue a file or folder of a project of this machine for another machine.",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "format": "uuid"
    },
    "path": {
      "description": "The file or folder, relative to the project root.",
      "type": "string"
    },
    "machine": {
      "description": "The target machine, by id or name.",
      "type": "string"
    },
    "dest": {
      "anyOf": [
        {
          "$ref": "#/$defs/PushDest"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "project_id",
    "path",
    "machine"
  ],
  "$defs": {
    "PushDest": {
      "description": "Where the files land on the target.",
      "oneOf": [
        {
          "description": "`~/Downloads/Kybern/<from machine>/`, the default.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "downloads"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "description": "A project of the target, named by id, name or path, with an optional folder inside it.",
          "type": "object",
          "properties": {
            "project": {
              "type": "string"
            },
            "subdir": {
              "description": "Relative to the project's root, `/`-separated, without `..`.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "project"
            }
          },
          "required": [
            "kind",
            "project"
          ]
        },
        {
          "description": "A skill's folder in the target's skill homes (`skills.copy`; see `skill_sync.rs`). Never `name (2)`:\nthe same version is left as it is, and a different one is replaced only when its hash is in `replaces`.",
          "type": "object",
          "properties": {
            "name": {
              "description": "[`crate::MachineSkill::name`], relative to each home.",
              "type": "string"
            },
            "homes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SkillHome"
              }
            },
            "hash": {
              "description": "The hash of the version that is sent.",
              "type": "string"
            },
            "replaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "skill"
            }
          },
          "required": [
            "kind",
            "name",
            "homes",
            "hash"
          ]
        }
      ]
    },
    "SkillHome": {
      "description": "A harness's user skill folder.",
      "oneOf": [
        {
          "description": "`~/.agents/skills`: read by Codex, Cursor, OpenCode and omp.",
          "type": "string",
          "const": "agents"
        },
        {
          "description": "`$CLAUDE_CONFIG_DIR/skills` or `~/.claude/skills`: Claude Code, also read by Cursor and OpenCode.",
          "type": "string",
          "const": "claude"
        },
        {
          "description": "`$CODEX_HOME/skills` or `~/.codex/skills`: Codex, also read by Cursor.",
          "type": "string",
          "const": "codex"
        },
        {
          "description": "`~/.cursor/skills`.",
          "type": "string",
          "const": "cursor"
        },
        {
          "description": "`$XDG_CONFIG_HOME/opencode/skills` or `~/.config/opencode/skills`.",
          "type": "string",
          "const": "opencode"
        },
        {
          "description": "`$PI_CODING_AGENT_DIR/skills` or `~/.pi/agent/skills`: pi, also read by omp.",
          "type": "string",
          "const": "pi"
        },
        {
          "description": "`~/.omp/agent/skills` (or the active omp profile's).",
          "type": "string",
          "const": "omp"
        }
      ]
    }
  }
}
