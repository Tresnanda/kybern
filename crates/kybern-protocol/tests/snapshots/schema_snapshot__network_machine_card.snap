---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(MachineCard)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MachineCard",
  "description": "One member as Settings → Machines shows it.",
  "type": "object",
  "properties": {
    "update": {
      "description": "Live progress, supported by update.progress.v1.",
      "anyOf": [
        {
          "$ref": "#/$defs/DaemonUpdate"
        },
        {
          "type": "null"
        }
      ]
    },
    "machine_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "os": {
      "type": "string"
    },
    "arch": {
      "type": [
        "string",
        "null"
      ]
    },
    "ts_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "signing_key": {
      "description": "The machine's Ed25519 signing key, standard base64. A client pins it, so a route can only\nattach to this machine by proving that key (§3.2).",
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "$ref": "#/$defs/MachineStatus"
    },
    "is_self": {
      "description": "This daemon.",
      "type": "boolean",
      "default": false
    },
    "version": {
      "type": [
        "string",
        "null"
      ]
    },
    "network_protocol": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "default": 0
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_seen_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "relay_via": {
      "description": "The member relaying to this machine when `status` is `relaying`.",
      "type": [
        "string",
        "null"
      ]
    },
    "harnesses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HarnessSummary"
      }
    },
    "allow": {
      "description": "Capabilities this machine lets the machine this card is served from use (`allow.*` registers).",
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "added_by": {
      "description": "\"Added by <machine>\": the signer of the machine's `add` operation.",
      "type": [
        "string",
        "null"
      ]
    },
    "added_via": {
      "anyOf": [
        {
          "$ref": "#/$defs/JoinVia"
        },
        {
          "type": "null"
        }
      ]
    },
    "added_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "machine_id",
    "name",
    "os",
    "status"
  ],
  "$defs": {
    "DaemonUpdate": {
      "description": "The daemon's own update state. The daemon replaces its binary from the\nGitHub release feed and restarts under its service manager; persisted so\nclients see the same record after a reconnect or the restart itself.",
      "type": "object",
      "properties": {
        "update_id": {
          "description": "Identity retained across the replacement process and its reconnect.",
          "type": [
            "string",
            "null"
          ]
        },
        "target_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "download_percent": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "busy_thread": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/DaemonUpdateStatus"
        },
        "message": {
          "type": "string"
        },
        "current_version": {
          "description": "Version of the running daemon.",
          "type": "string"
        },
        "latest_version": {
          "description": "Newest published version, once a check has succeeded.",
          "type": [
            "string",
            "null"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "status",
        "message",
        "current_version"
      ]
    },
    "DaemonUpdateStatus": {
      "type": "string",
      "enum": [
        "not_checked",
        "checking",
        "current",
        "available",
        "waiting",
        "updating",
        "restarting",
        "unsupported",
        "failed"
      ]
    },
    "MachineStatus": {
      "description": "Whether a machine can be reached right now.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "online",
            "offline"
          ]
        },
        {
          "description": "Only a relay route works.",
          "type": "string",
          "const": "relaying"
        },
        {
          "description": "Paused by the owner: ops still sync, nothing else opens.",
          "type": "string",
          "const": "paused"
        }
      ]
    },
    "HarnessSummary": {
      "description": "A harness on a machine, in the short form the Machines page shows.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "available": {
          "type": "boolean"
        },
        "signed_in": {
          "description": "Absent when the daemon cannot tell.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "available"
      ]
    },
    "ProviderKind": {
      "description": "Coding agent backends the daemon can drive. Each has its own native driver.",
      "type": "string",
      "enum": [
        "claude-code",
        "codex",
        "opencode",
        "pi",
        "omp",
        "cursor",
        "antigravity",
        "grok-build"
      ]
    },
    "JoinVia": {
      "description": "How a machine was added.",
      "oneOf": [
        {
          "description": "Same Tailscale user, no clicks.",
          "type": "string",
          "const": "auto"
        },
        {
          "description": "\"Found on your tailnet · Add\".",
          "type": "string",
          "const": "found"
        },
        {
          "description": "Six-digit code or QR.",
          "type": "string",
          "const": "code"
        },
        {
          "description": "A saved environment became a member.",
          "type": "string",
          "const": "migrate"
        }
      ]
    }
  }
}
