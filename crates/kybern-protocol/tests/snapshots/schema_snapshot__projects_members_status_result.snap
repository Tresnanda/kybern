---
source: crates/kybern-protocol/tests/schema_snapshot.rs
expression: schema_for!(ProjectsMembersStatusResult)
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectsMembersStatusResult",
  "type": "object",
  "properties": {
    "members": {
      "description": "In project order (primary first).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/MemberState"
      }
    },
    "agents_md": {
      "description": "Which shared instruction files exist in the group folder.",
      "type": "boolean"
    },
    "claude_md": {
      "type": "boolean"
    },
    "copy_candidates": {
      "description": "Entries the \"Also copy into worktrees\" picker offers, sorted by name.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/CopyCandidate"
      }
    },
    "pending": {
      "description": "Repositories another machine added to this group that this machine is still adding, or could not add.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/PendingMember"
      }
    }
  },
  "required": [
    "members",
    "agents_md",
    "claude_md"
  ],
  "$defs": {
    "MemberState": {
      "description": "Live state of one member, for the Repositories dialog, badge tooltip and mobile.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/MemberStatus"
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "detached": {
          "type": "boolean"
        },
        "dirty_files": {
          "description": "Uncommitted files (`git status --porcelain` lines).",
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "default": 0
        },
        "remote_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "instructions": {
          "description": "The member's own instruction file relative to the group folder\n(`api/AGENTS.md`, else `api/CLAUDE.md`), when it has one.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "name",
        "status"
      ]
    },
    "MemberStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "ok"
          ]
        },
        {
          "description": "The folder is gone (deleted or renamed).",
          "type": "string",
          "const": "missing"
        },
        {
          "description": "The folder exists but is no longer a git repository.",
          "type": "string",
          "const": "not_git"
        }
      ]
    },
    "CopyCandidate": {
      "description": "A top-level entry of the group folder that may go in `Project.worktree_copy`.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Entry name (top level only, never a member or `.git`).",
          "type": "string"
        },
        "is_dir": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "is_dir"
      ]
    },
    "PendingMember": {
      "description": "A repository another machine added to the same group, on its way to this machine.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Where it goes inside the group folder.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "remote_url": {
          "description": "The `origin` this machine clones from, without credentials.",
          "type": [
            "string",
            "null"
          ]
        },
        "problem": {
          "description": "Set when the last try failed; absent while it is being added.",
          "anyOf": [
            {
              "$ref": "#/$defs/Problem"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "name"
      ]
    },
    "Problem": {
      "description": "What went wrong in terms a person can act on, sent as an RPC error's `data.problem` (and in\nresults that report per-item failures). Additive: `message` stays the readable fallback, and\nclients that don't know a `kind` show `message`. Clients prefer their own copy keyed by\n`kind` and `subject`; `title` and `hint` are the daemon's fallback copy.",
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ProblemKind"
        },
        "subject": {
          "description": "What the problem is about, e.g. `gh` for the GitHub CLI.",
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "description": "The one action that fixes it, when there is one.",
          "anyOf": [
            {
              "$ref": "#/$defs/ProblemAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "secondary": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProblemAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "detail": {
          "description": "The full technical error, for a Details disclosure; never the headline.",
          "type": [
            "string",
            "null"
          ]
        },
        "retryable": {
          "description": "Trying the same call again can succeed once the cause is fixed.",
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "kind"
      ]
    },
    "ProblemKind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "conflict",
            "invalid_input",
            "not_found",
            "update_needed",
            "internal"
          ]
        },
        {
          "description": "A program Kybern needs isn't installed or can't be found.",
          "type": "string",
          "const": "tool_missing"
        },
        {
          "description": "Nobody is signed in where the call needs an account.",
          "type": "string",
          "const": "signed_out"
        },
        {
          "description": "The account is signed in but not allowed to do this.",
          "type": "string",
          "const": "permission"
        },
        {
          "description": "A machine or service can't be reached.",
          "type": "string",
          "const": "offline"
        }
      ]
    },
    "ProblemAction": {
      "description": "A button a client can offer. `id` is what the client does (`install_tool`, `sign_in`,\n`retry`, ...); `params` carry what it needs, e.g. `{ \"tool\": \"gh\" }`.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "params": true
      },
      "required": [
        "id",
        "label"
      ]
    }
  }
}
