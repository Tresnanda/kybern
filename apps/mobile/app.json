{
  "expo": {
    "name": "Kybern",
    "slug": "kybern-mobile",
    "version": "0.1.1",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/8a6031c9-5d00-4377-9114-546bd7736a9d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "scheme": "kybern",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.kybern.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "NSLocalNetworkUsageDescription": "Connect to Kybern on your computer.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "package": "dev.kybern.mobile",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withSceneLifecycle",
      "./plugins/withAndroidLocalNetworking",
      [
        "expo-camera",
        {
          "cameraPermission": "Take photos to attach to messages and scan Kybern pairing codes.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos to attach to your messages.",
          "cameraPermission": "Take photos to attach to messages and scan Kybern pairing codes.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "owner": "treshnanda",
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "enforceContrast": false
      },
      "eas": {
        "projectId": "8a6031c9-5d00-4377-9114-546bd7736a9d"
      }
    }
  }
}
