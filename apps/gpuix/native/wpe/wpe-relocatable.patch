+// Kybern: WPE ships inside Kybern's packages (AppImage, .deb, .rpm) at a path only known at run time, so the
+// directories compiled in as LIBDIR/PKGLIBDIR/PKGLIBEXECDIR are resolved beside the loaded libWPEWebKit instead.
+// See apps/gpuix/native/wpe/README.md in the Kybern repository.
+#ifndef KYBERN_RELOCATED_DIRS
+#define KYBERN_RELOCATED_DIRS
+#include <dlfcn.h>
+static const char* kybernRelocatedLibDir()
+{
+    static char* directory = [] {
+        Dl_info info;
+        if (dladdr(reinterpret_cast<void*>(&kybernRelocatedLibDir), &info) && info.dli_fname && info.dli_fname[0] == '/')
+            return g_path_get_dirname(info.dli_fname);
+        return g_strdup(LIBDIR);
+    }();
+    return directory;
+}
+static const char* kybernRelocatedPkgLibDir()
+{
+    static char* directory = g_build_filename(kybernRelocatedLibDir(), "wpe-webkit-2.0", nullptr);
+    return directory;
+}
+#endif
