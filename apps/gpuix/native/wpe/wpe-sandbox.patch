+// Kybern: see Sandbox.h. Set once, before WebKit spawns anything; read by the container check and the launcher.
+static std::atomic<bool> kybernBundledBubblewrap { false };
+static const char* kybernBundledBubblewrapPath()
+{
+    static char* path = []() -> char* {
+        Dl_info info;
+        if (!dladdr(reinterpret_cast<void*>(&kybernBundledBubblewrapPath), &info) || !info.dli_fname || info.dli_fname[0] != '/')
+            return nullptr;
+        char* directory = g_path_get_dirname(info.dli_fname);
+        char* bwrap = g_build_filename(directory, "wpe-webkit-2.0", "bwrap", nullptr);
+        g_free(directory);
+        return bwrap;
+    }();
+    return path;
+}
+
+bool kybernSelectBundledBubblewrap()
+{
+    const char* path = kybernBundledBubblewrapPath();
+    if (!path || !g_file_test(path, G_FILE_TEST_IS_EXECUTABLE))
+        return false;
+    kybernBundledBubblewrap = true;
+    return true;
+}
+
+const char* kybernBubblewrapExecutable()
+{
+    return kybernBundledBubblewrap ? kybernBundledBubblewrapPath() : BWRAP_EXECUTABLE;
+}
