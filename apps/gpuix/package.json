{
  "name": "kybern-gpuix",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Experimental Kybern client rendered natively with GPUIX (React on Zed's GPUI).",
  "scripts": {
    "dev": "bun --hot src/main.tsx",
    "start": "bun src/main.tsx",
    "screenshot": "bun scripts/screenshot.ts",
    "typecheck": "tsc --noEmit",
    "package:app": "bun scripts/package-app.ts"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "@gpuix/native": "0.11.0",
    "@gpuix/react": "0.11.0",
    "@hugeicons/core-free-icons": "4.3.3",
    "html-url-attributes": "3.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-markdown": "2.1.2",
    "mermaid": "12.0.0",
    "react": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/bun": "1.4.3",
    "@types/react": "19.2.18",
    "typescript": "7.0.2"
  }
}
